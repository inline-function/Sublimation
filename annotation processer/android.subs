// android.subs —— @android 内建函数处理器（android doc/安卓标准库.md）
//
// 职责：@android 与 @root 同构——标注安卓内建（log/toast/layout/7 个生命周期/androidRecompose），
//   函数无体、由编译器内建 JS 桥接（JsCodeGen __dshAndroid）。
//
// 本处理器只做户态度校验（不改 AST → 天然幂等）：
//   1. @android 函数必须在编译器白名单内（不在 → processorError，与 E-ANDROID-NOT-ALLOWED 同源）；
//   2. @android 函数必须 @impure（桥接原生有副作用，缺则提示）；
//   3. @android 函数无体（有体 → 错误：内建函数的实现由编译器提供）。

fun checkFuns(xs: List[Str]): Null =
    when (xs) {
        Nil => null
        is Cons(f, rest) => { checkOne(f); checkFuns(rest) }
        else => null
    }

fun checkOne(fn: Str): Null {
    if (!funHasAnnotation(fn, "android")) null else {
        // 例外：view.subs 生成的 recomposion$X$N 是带体桥接函数（体 = androidRecompose(...)），
        // 不是用户写的内建声明——白名单/无体校验只对用户声明生效。
        if (startsWith(fn, "recomposion$")) null else {
            var anns: List[Str] = funAnnotations(fn);
            checkWhitelist(fn);
            checkImpure(fn, anns);
            checkNoBody(fn)
        }
    }
}

fun checkWhitelist(fn: Str): Null {
    if (isAndroidBuiltin(fn)) null else processorError("@android 函数 " + fn + " 不是编译器支持的安卓内建。内建含 log/toast/layout/onCreate/onStart/onResume/onPause/onStop/onDestroy/onRestart/androidRecompose")
}

fun checkImpure(fn: Str, anns: List[Str]): Null {
    if (containsAnno(anns, "impure")) null
    else processorWarn("@android 函数 " + fn + " 缺 @impure：桥接原生有副作用，缺省为不纯")
}

fun checkNoBody(fn: Str): Null {
    if (funHasBody(fn)) processorError("@android 函数 " + fn + " 不应有函数体：内建实现由编译器提供")
    else null
}

fun containsAnno(xs: List[Str], a: Str): Bool =
    when (xs) {
        Nil => false
        is Cons(h, rest) => if (h == a) true else containsAnno(rest, a)
        else => false
    }

fun isAndroidBuiltin(fn: Str): Bool =
    when (fn) {
        "log" => true
        "toast" => true
        "layout" => true
        "onCreate" => true
        "onStart" => true
        "onResume" => true
        "onPause" => true
        "onStop" => true
        "onDestroy" => true
        "onRestart" => true
        "androidRecompose" => true
        else => false
    }

checkFuns(funNames(0))