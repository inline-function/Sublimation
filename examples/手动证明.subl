// ============================================================
// 特性：手动证明（∵∴ 链 / 多前提逗号 / by 断言 / 上下文弥散）
// 预期输出（每行一个）：premises / mp / diffuse / by / done
// ============================================================

// 上文 <p>：调用点须供给（下文弥散供给；by 断言只核对、不供给）
fun produceP(): Null <p> {
    axiom p
}
fun consumeP()<p>: Null {}

@impure fun main() {
    axiom offer
    axiom offer → granted              // MP 闭包产出 granted
    axiom base

    // 多前提证明链：逗号分隔前提
    ∵ base, offer ∴ granted

    // 上下文弥散：下文兑现后供给后续调用的上文
    produceP()
    consumeP()

    // by 断言（t30 新语义）：核对 p 成立——p 已由 produceP 的下文弥散供给，断言可证
    consumeP() by [p]

    print("premises")
    print("mp")
    print("diffuse")
    print("by")
    print("done")
}