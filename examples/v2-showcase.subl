// ==================== Sublimation v2.0 特性展示 ====================
// 覆盖：空安全（T? / ?: / >: / ?T / 智能转换）· 异步（@async / Task / Channel / sleep）
//      · 可变性自然命题（immutable<T> / untouch<param>）· 基本库（zip / distinct / toSet / toMap）
// 顶层只放声明，执行全在 main（决策 74）；main 天然 @async（决策 93）。
// 块体无尾表达式即返回 Null（Kotlin Unit 语义）——不写 `Null` 作尾表达式（Null 是类型不是值）。

// ---------- ① 空安全 ----------

struct Point(x: Nat, y: Nat)

// T? = Optional[T]（决策 89）；?: 空替代；>: 安全转换（返回 Optional[T]）
@unpure fun nullSafety() {
    var age: Optional[Nat] = Some(5)
    var a: Nat = age ?: 0                 // Some(5) -> 5
    print("elvis(Some) = ${a}")

    var none: Optional[Nat] = None()
    var b: Nat = none ?: 7                // None -> 默认 7
    print("elvis(None) = ${b}")

    var maybe: Optional[Str] = Some("sam")
    var name: Str = maybe ?: "anonymous"  // Str 通道的 elvis
    print("elvis(Str) = ${name}")

    // >: 安全转换（类型断言 + 收窄）：接收者运行时确为 T 则 Some(T)，否则 None
    var n: Nat = age ?: 0                 // 已解包为 Nat（elvis）
    var cast = n >: Nat                   // __isa(9, "Nat") -> true -> Some(9)
    var got = stdlib.getOrElse(cast, 0)
    print("safeCast = ${got}")
}

// 智能转换（决策 88-92 余项）：if (o ? Point) 分支内 o 收窄为 Point（Any -> Point）
@unpure fun smartCast(o: Any) {
    if (o ? Point) {
        var p: Point = o                  // 分支内直接按 Point 使用
        print("smart cast: p.x = ${p.x}")
    }
}

// ---------- ② 异步 ----------

// @async 挂起操作（sleep / send / receive）须在 async 上下文；Task 体天然 async（TASK-5）
@unpure @async fun fill(ch: Channel[Nat]) {
    ch.send(10)
    sleep(5)                              // 挂起点自动 await（SUSP-2）
    ch.send(20)
    ch.close()                            // CH-6：close 后 send 才报 E-CHANNEL-CLOSED
}

// CH-5 + 阶段5 智能转换：if (!ch.isClosed()) 分支内 receive 返回 T（解包），否则 T?
@unpure @async fun consume(ch: Channel[Nat]) {
    if (!ch.isClosed()) {
        var v: Nat = ch.receive()         // 本地未关闭 -> 智能转换为 Nat
        print("channel receive = ${v}")
    }
}

@unpure @async fun asyncDemo() {
    // Task：创建不启动（TASK-1），start 启动、isAlive 查存活、join 挂起等待（TASK-3/4/7）
    var ch: Channel[Nat] = Channel<Nat>(2)   // 有缓冲通道（值位用尖括号，CH-2）
    var t = Task { fill(ch) }
    t.start()
    if (t.isAlive()) { print("task alive...") }
    t.join()
    print("task joined")

    // 单独演示 receive 智能转换（不 close，send 后马上 receive）
    var ch2: Channel[Nat] = Channel<Nat>(1)
    ch2.send(7)
    if (!ch2.isClosed()) {
        var v: Nat = ch2.receive()
        print("channel receive(smart) = ${v}")
    }
}

// ---------- ③ 可变性自然命题（副作用 §4.2 / §6.2） ----------

// 编译器自动注入 immutable<Point>：Point 无 @mut 字段且字段类型 immutable
// 后置条件 <immutable<Point>> 可证明（E-POST-UNPROVEN 不会触发）
fun pointGuard(p: Point) : Null <immutable<Point>> {}

// 非 @mut 形参自动注入 untouch<param>——函数体未改 x，untouch<x> 可证明
fun sanitize(x: Nat) : Null <untouch<x>> {}

// ---------- ④ 基本库 ----------

@unpure fun basicLib() {
    var xs: List[Nat] = stdlib.range(1, 4)             // [1,2,3]
    var z = stdlib.zip(xs, xs)                          // List[(Nat,Nat)]
    var m = stdlib.toMap(z)                             // Map[Nat,Nat]
    var d = stdlib.distinct(stdlib.append(xs, xs))      // [1,2,3]
    print("zip=${z.size()} map=${m.size()} distinct=${d.size()}")
}

// ---------- main ----------

@unpure fun main() {
    nullSafety()
    smartCast(Point(1, 2))
    asyncDemo()
    basicLib()
}