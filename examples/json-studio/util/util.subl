// ============================================================
// util 子模块（P0 模块系统展示）：根模块 main.subl 经 util.xxx 跨模块限定调用。
// 只含纯字符串/数字工具，不碰 Json（避免"跨模块构造子模式不可写"的限制）。
// 说明：除非特别注释，否则均按 P9 停机判定实现（结构递归 或 unchecked 逃逸）。
// ============================================================

fun triple(x: Nat): Nat = x * 3

// 左侧补空格到宽度 w；索引递减递归，P9 判不出 → unchecked 逃逸
fun padLeft(s: Str, w: Nat): Str {
    if length(s) >= w { s }
    else { unchecked var r = padLeft(concat(" ", s), w - 1); r }
}

fun signum(n: Int): Int = if n < 0 { -1 } else { if n > 0 { 1 } else { 0 } }

fun clampNat(n: Nat, lo: Nat, hi: Nat): Nat = if n < lo { lo } else { if n > hi { hi } else { n } }

// 重复字符串；索引递减递归 → unchecked
fun repeat(s: Str, n: Nat): Str {
    if n <= 0 { "" }
    else { unchecked var r = repeat(s, n - 1); concat(s, r) }
}

fun plural(n: Nat): Str = if ==(n, 1) { "item" } else { "items" }

// 把 Nat 列表转成空格分隔的一行（示意跨模块复用 stdlib 风格高阶 + 元组参数）
fun sumAll(@tuple t: (Nat, Nat)): Nat = when(t) { (a, b) -> a + b; _ -> 0 }
