// ============================================================
// v1.0 特性大全压测（Sublimation 特性巡礼，~500 行）
// 目标：单跑一个程序覆盖 v1.0 绝大多数语言特性，check 0 错误 + node 跑通。
// 模块结构：main.subl（根模块，核心）+ util/util.subl（子模块，跨模块限定调用展示）。
// 运行： gradlew run --args="check examples\json-studio"
//        gradlew run --args="compile examples\json-studio -o <out>.js"  && node <out>.js
// 覆盖清单（对照 doc/语言简介.md）：
//   类型：递归 enum / struct / 泛型 / 约束 typeclass / 元组 / Optional
//   上下文：命题前置后件 / unchecked.axiom / 自动供给 / P4 等式推理 / when 守卫
//   模式：构造子 / 元组解构 / 守卫 / else 兜底 / 绑定主题
//   值：Str / Nat / Int / Rat / Bool / List / 插值 / 命名参数
//   高阶：lambda / fold / map / filter；@tuple；if 无括号；return 流；unchecked 逃逸
//   模块：跨模块限定调用 util.xxx；类型位置裸名
// ============================================================

// ---------- 0. 类型定义 ----------
enum JList[T] { JNil(), JCons(T, JList<T>) }
enum Json { JNull(), JBool(Bool), JNum(Rat), JStr(Str), JArr(JList<Json>), JObj(JList<Pair>) }
struct Pair(k: Str, v: Json)
enum Ret { Ok(Json, Nat), Fail(Str) }

// ---------- 1. 集合（结构递归，P9 放行：解构绑定是结构子项） ----------
fun jLen[T](xs: JList<T>): Nat = when(xs) {
    JNil() -> 0
    JCons(_, t) -> 1 + jLen(t)
    _ -> 0
}

fun jMap[T, U](f: (T) => U, xs: JList<T>): JList<U> = when(xs) {
    JNil() -> JNil()
    JCons(h, t) -> JCons(f(h), jMap(f, t))
    _ -> JNil()
}

fun jFilter[T](f: (T) => Bool, xs: JList<T>): JList<T> = when(xs) {
    JNil() -> JNil()
    JCons(h, t) -> if (f(h)) { JCons(h, jFilter(f, t)) } else { jFilter(f, t) }
    _ -> JNil()
}

fun jFold[T, U](init: U, f: (T, U) => U, xs: JList<T>): U = when(xs) {
    JNil() -> init
    JCons(h, t) -> jFold(f(h, init), f, t)
    _ -> init
}

fun jAppend[T](xs: JList<T>, ys: JList<T>): JList<T> = when(xs) {
    JNil() -> ys
    JCons(h, t) -> JCons(h, jAppend(t, ys))
    _ -> ys
}

fun jRev[T](xs: JList<T>): JList<T> = jFold(JNil(), \(h, acc) => JCons(h, acc), xs)

// ---------- 2. 字符辅助 ----------
fun isDigit(c: Str): Bool = ==(c, "0") | ==(c, "1") | ==(c, "2") | ==(c, "3") | ==(c, "4") | ==(c, "5") | ==(c, "6") | ==(c, "7") | ==(c, "8") | ==(c, "9")
fun isWs(c: Str): Bool = ==(c, " ") | ==(c, "\n") | ==(c, "\t") | ==(c, "\r")
fun isNumStart(c: Str): Bool = isDigit(c) | ==(c, "-")

fun skipWs(s: Str, i: Nat): Nat {
    if (isWs(charAt(s, i))) {
        unchecked var r = skipWs(s, i + 1)
        r
    } else { i }
}

// ---------- 3. 解析器（索引递归 i→i+1，P9 判不出 → unchecked 逃逸） ----------
fun parseNull(s: Str, i: Nat): Ret =
    if (==(substring(s, i, i + 4), "null")) { Ok(JNull(), i + 4) } else { Fail("期望 null @ " + toStr(i)) }

fun parseTrue(s: Str, i: Nat): Ret =
    if (==(substring(s, i, i + 4), "true")) { Ok(JBool(true), i + 4) } else { Fail("期望 true @ " + toStr(i)) }

fun parseFalse(s: Str, i: Nat): Ret =
    if (==(substring(s, i, i + 5), "false")) { Ok(JBool(false), i + 5) } else { Fail("期望 false @ " + toStr(i)) }

fun numEnd(s: Str, i: Nat): Nat {
    if (isDigit(charAt(s, i)) | ==(charAt(s, i), "-") | ==(charAt(s, i), "+") | ==(charAt(s, i), ".")) {
        unchecked var r = numEnd(s, i + 1)
        r
    } else { i }
}

fun parseNumber(s: Str, i: Nat): Ret {
    var e = numEnd(s, i)
    when(parseRat(substring(s, i, e))) {
        Some(v) -> Ok(JNum(v), e)
        None -> Fail("坏数字 @ " + toStr(i))
    }
}

fun parseStrBody(s: Str, i: Nat, acc: Str): Ret = when(charAt(s, i)) {
    "\"" -> Ok(JStr(acc), i + 1)
    "\\" -> parseEscape(s, i, acc)
    "" -> Fail("字符串未闭合 @ " + toStr(i))
    _ -> {
        unchecked var r = parseStrBody(s, i + 1, concat(acc, charAt(s, i)))
        r
    }
}

fun parseEscape(s: Str, i: Nat, acc: Str): Ret = when(charAt(s, i + 1)) {
    "\"" -> { unchecked var r = parseStrBody(s, i + 2, concat(acc, "\"")); r }
    "\\" -> { unchecked var r = parseStrBody(s, i + 2, concat(acc, "\\")); r }
    "n" -> { unchecked var r = parseStrBody(s, i + 2, concat(acc, "\n")); r }
    "t" -> { unchecked var r = parseStrBody(s, i + 2, concat(acc, "\t")); r }
    "r" -> { unchecked var r = parseStrBody(s, i + 2, concat(acc, "\r")); r }
    _ -> Fail("未知转义 @ " + toStr(i))
}

fun parseArr(s: Str, i: Nat, acc: JList<Json>): Ret {
    var j = skipWs(s, i)
    if (==(charAt(s, j), "]")) { Ok(JArr(jRev(acc)), j + 1) }
    else {
        var r = parseValue(s, j)
        when(r) {
            Ok(v, k) -> {
                var k2 = skipWs(s, k)
                if (==(charAt(s, k2), ",")) {
                    unchecked var r2 = parseArr(s, k2 + 1, JCons(v, acc))
                    r2
                } else { if (==(charAt(s, k2), "]")) { Ok(JArr(jRev(JCons(v, acc))), k2 + 1) } else { Fail("期望 , 或 ] @ " + toStr(k2)) } }
            }
            Fail(e) -> Fail(e)
        }
    }
}

fun strOf(j: Json): Str = when(j) { JStr(x) -> x; _ -> "" }

fun parseObj(s: Str, i: Nat, acc: JList<Pair>): Ret {
    var j = skipWs(s, i)
    if (==(charAt(s, j), "}")) { Ok(JObj(jRev(acc)), j + 1) }
    else {
        var rk = parseStrBody(s, j + 1, "")
        when(rk) {
            Ok(kv, k) -> {
                var k2 = skipWs(s, k)
                if (!=(charAt(s, k2), ":")) { Fail("期望 : @ " + toStr(k2)) }
                else {
                    var rv = parseValue(s, k2 + 1)
                    when(rv) {
                        Ok(v, m) -> {
                            var m2 = skipWs(s, m)
                            var pr = Pair(strOf(kv), v)
                            if (==(charAt(s, m2), ",")) {
                                unchecked var r2 = parseObj(s, m2 + 1, JCons(pr, acc))
                                r2
                            } else { if (==(charAt(s, m2), "}")) { Ok(JObj(jRev(JCons(pr, acc))), m2 + 1) } else { Fail("期望 , 或 } @ " + toStr(m2)) } }
                        }
                        Fail(e) -> Fail(e)
                    }
                }
            }
            Fail(e) -> Fail(e)
        }
    }
}

// 命名参数展示（P8）：同职责一个函数，位置实参按声明顺序重排
fun parseAt(s: Str, i: Nat, ws: Bool): Ret = if (==(ws, true)) { parseValueAt(s, skipWs(s, i)) } else { parseValueAt(s, i) }
fun parseValue(s: Str, i: Nat): Ret = parseAt(s = s, ws = true, i = i)

fun parseValueAt(s: Str, j: Nat): Ret = when(charAt(s, j)) {
    "n" -> parseNull(s, j)
    "t" -> parseTrue(s, j)
    "f" -> parseFalse(s, j)
    "\"" -> parseStrBody(s, j + 1, "")
    "[" -> parseArr(s, j + 1, JNil())
    "{" -> parseObj(s, j + 1, JNil())
    _ -> if (isNumStart(charAt(s, j))) { parseNumber(s, j) } else { Fail("期望值 @ " + toStr(j)) }
}

fun parse(s: Str): Ret = parseValue(s, 0)

// ---------- 4. 序列化（型类约束） ----------
class Show[T] { fun show(): Str }
impl Show for Json { fun show(): Str = showFull(self) }

fun showFull(j: Json): Str = when(j) {
    JNull() -> "null"
    JBool(b) -> if (b) { "true" } else { "false" }
    JNum(n) -> toStr(n)
    JStr(x) -> concat("\"", concat(x, "\""))
    JArr(l) -> showArr(l)
    JObj(p) -> showObj(p)
    _ -> "?"
}

fun showArr(l: JList<Json>): Str {
    var inner = jFold("", \(x, acc) => if (==(acc, "")) { showFull(x) } else { concat(acc, concat(",", showFull(x))) }, l)
    concat("[", concat(inner, "]"))
}

fun showPair(p: Pair): Str = concat("\"", concat(p.k, concat("\"", concat(":", showFull(p.v)))))

fun showObj(ps: JList<Pair>): Str {
    var inner = jFold("", \(x, acc) => if (==(acc, "")) { showPair(x) } else { concat(acc, concat(",", showPair(x))) }, ps)
    concat("{", concat(inner, "}"))
}

// 约束函数：需要 T: Show 字典（自动推理从 impl 补全）
fun showAll[T: Show](xs: JList<T>): Str = jFold("", \(x, acc) => concat(acc, x.show()), xs)

// ---------- 5. 查询 / 统计 / 变换（结构递归 + Optional + 元组） ----------
fun countNodes(j: Json): Nat = when(j) {
    JArr(l) -> 1 + countList(l)
    JObj(p) -> 1 + countPairs(p)
    _ -> 1
}
fun countList(l: JList<Json>): Nat = when(l) {
    JNil() -> 0
    JCons(h, t) -> countNodes(h) + countList(t)
    _ -> 0
}
fun countPairs(p: JList<Pair>): Nat = when(p) {
    JNil() -> 0
    JCons(pr, t) -> 2 + countNodes(pr.v) + countPairs(t)
    _ -> 0
}

fun depth(j: Json): Nat = when(j) {
    JArr(l) -> 1 + depthList(l)
    JObj(p) -> 1 + depthPairs(p)
    _ -> 0
}
fun depthList(l: JList<Json>): Nat = when(l) {
    JNil() -> 0
    JCons(h, t) -> max(depth(h), depthList(t))
    _ -> 0
}
fun depthPairs(p: JList<Pair>): Nat = when(p) {
    JNil() -> 0
    JCons(pr, t) -> max(depth(pr.v), depthPairs(t))
    _ -> 0
}
fun max(a: Nat, b: Nat): Nat = if a > b { a } else { b }

// 找某个键第一次出现的对象值，返回 Optional<Json>
fun findKey(j: Json, key: Str): Optional<Json> = when(j) {
    JObj(ps) -> findInPairs(ps, key)
    _ -> None()
}
fun findInPairs(ps: JList<Pair>, key: Str): Optional<Json> = when(ps) {
    JNil() -> None()
    JCons(pr, t) -> if (==(pr.k, key)) { Some(pr.v) } else { findInPairs(t, key) }
    _ -> None()
}

// 汇总所有数字（Rat 求和，浮点展示）
fun sumNumbers(j: Json): Rat = when(j) {
    JNum(n) -> n
    JArr(l) -> sumList(l)
    JObj(p) -> sumPairs(p)
    _ -> 0.0
}
fun sumList(l: JList<Json>): Rat = when(l) {
    JNil() -> 0.0
    JCons(h, t) -> sumNumbers(h) + sumList(t)
    _ -> 0.0
}
fun sumPairs(p: JList<Pair>): Rat = when(p) {
    JNil() -> 0.0
    JCons(pr, t) -> sumNumbers(pr.v) + sumPairs(t)
    _ -> 0.0
}

// 元组：返回 (最小值, 最大值)，展示元组字面量 + 调用方解构
fun jMinMax(xs: JList<Rat>): (Rat, Rat) = when(xs) {
    JNil() -> (0.0, 0.0)
    JCons(h, t) -> {
        var p = jMinMax(t)
        when(p) { (lo, hi) -> (min(lo, h), max(hi, h)); _ -> (h, h) }
    }
    _ -> (0.0, 0.0)
}
fun min(a: Rat, b: Rat): Rat = if a < b { a } else { b }

// when 守卫 + 绑定主题展示（无 % token：n/2*2==n 判偶，Rat 精确整除）
fun classify(n: Nat): Str = when(n) {
    _ if ==(n / 2 * 2, n) -> "even"
    _ if n > 10 -> "big-odd"
    _ -> "odd"
}

// ---------- 6. 命题层（前置/后件 + unchecked.axiom + P4 自动供给 + 等式推理） ----------
fun giveP(): Null <p> { unchecked.axiom[p] }
fun takeP()<p>: Null {}

fun need5(n: Nat)<n = 5>: Null {}
fun supply5(): Null { var x = 5; need5(x) }

// ---------- 7. main（IO：纯用 @unpure 包 print） ----------
@unpure fun main() {
var js = "{\"name\": \"alice\", \"age\": 30, \"pi\": 3.14, \"tags\": [1, 2.5, \"x\", [4, 5]], \"meta\": {\"ok\": true, \"none\": null}}"
when(parse(js)) {
    Ok(v, _) -> print("解析+show：${showFull(v)}")
    Fail(e) -> print("ERR: $e")
}
when(parse(js)) {
    Ok(v, _) -> {
        var n = countNodes(v); var d = depth(v); var s = sumNumbers(v)
        print("统计：节点 $n，深度 $d，数字和 $s")
    }
    Fail(e) -> print("ERR: $e")
}
when(findKey(parse(js), "pi")) {   // findKey 直接吃 parse 返回值（Ret）？—— 需解开
    Some(x) -> print("找到 pi = ${showFull(x)}")
    None -> print("没找到 pi")
}
when(parse(js)) {
    Ok(v, _) -> when(findKey(v, "tags")) {
        Some(x) -> print("tags = ${showFull(x)}")
        None -> print("没找到 tags")
    }
    Fail(e) -> print("ERR: $e")
}
// 命名参数 + 跨模块 util
print("跨模块：${util.triple(4)}；padLeft='${util.padLeft(\"ab\", 5)}'；repeat='${util.repeat(\"ha\", 3)}'；${util.plural(3)}")
// 守卫 + 元组 + 高阶
print("classify(6)=${classify(6)} classify(13)=${classify(13)} classify(7)=${classify(7)}")
var mm = jMinMax(jMap(\(x) => x * 2.0, JCons(3.0, JCons(1.0, JCons(5.0, JNil())))))
when(mm) { (lo, hi) -> print("minmax = ${lo}..${hi}") }
// 约束 showAll
print("showAll = ${showAll(JCons(JNum(1.0), JCons(JStr(\"hi\"), JNil())))}")
// 命题层
giveP(); takeP()   // 前件自动供给
print("命题供给 OK")
}
