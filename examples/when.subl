// ============================================================
// when 全形态：穷尽（覆盖律）、非穷尽（W-NON-EXHAUSTIVE 警告）、
// 守卫、顺序否定（后分支持有前分支命题的否定）
// ============================================================
enum Color { Red, Green, Blue }

// 密封：分支命题 Color=Red ∨ Color=Green ∨ Color=Blue 由覆盖律可证恒真
fun name(c: Color): Str {
    return when(c) {
        Red -> "红"
        Green -> "绿"
        Blue -> "蓝"
    }
}

// 非穷尽：缺 Blue，报 W-NON-EXHAUSTIVE；返回 Null 故值退化不报错
// （分支体是表达式位，不能写语句前缀 unchecked——决策 67）
fun partial(c: Color): Null {
    when(c) {
        Red -> 1
        Green -> 2
    }
}

// Bool 覆盖律 + 顺序否定：false 分支内持有 bool ≠ true
fun pick(b: Bool): Nat {
    return when(b) {
        true -> 1
        false -> 0
    }
}

// 守卫：分支条件带运行期判断。
// ⚠️ 守卫是**值位**（编译成 JS 条件），必须用 Bool 值：`!=(m, 0)` 前缀调用（决策 32：!= 禁中缀）
//    与 `&`（→ JS `&&`）。命题算符（u!=/u&/=/u-> 等）在值位会被擦成 true，不可用于守卫。
fun range(n: Nat): Str {
    return when(n) {
        0 -> "zero"
        m if !=(m, 0) & !=(m, 1) -> "many"
        else -> "small"
    }
}

fun main() {
    unchecked print(name(Red))       // 红
    partial(Blue)                    // 只警告不报错
    unchecked print(pick(true))      // 1
    unchecked print(range(0))        // zero
    unchecked print(range(7))        // many
    unchecked print(range(1))        // small
}
