// ============================================================
// v1.0 特性巡礼（P11 验收副产品，v1.0补全计划.md §13.4）
// 一行一段特性：P2 集合、P4 泛型约束 + 自动推理、P8 插值 + 命名参数、
//   P9 结构递归停机判定、P10 浮点 Rat、命题层（决策 65/66）。
// 完全自包含（连 List 都自带，不依赖 stdlib）；`gradlew run --args="check examples\v1-showcase.subl"` 应 0 错误。
// ============================================================

// ---- P2/P9：自建递归 List——遍历用构造子模式解构，P9 停机判定"结构子项"放行 ----
enum L[T] { LNil(), LCons(T, L<T>) }

fun len[T](xs: L<T>): Nat = when(xs) {
    LNil() -> 0
    LCons(_, t) -> 1 + len(t)
    _ -> 0
}

// ---- P4：泛型约束 T: Show——字典槽自动补全（I-22 约束事实与命题参数同构） ----
class Show[T] { fun show(): Str }
impl Show for Nat { fun show(): Str = toStr(self) }
impl Show for Str { fun show(): Str = self }

fun joinAll[T: Show](xs: L<T>): Str = when(xs) {
    LNil() -> ""
    LCons(h, t) -> concat(h.show(), joinAll(t))
    _ -> ""
}

// ---- P10：浮点 Rat（决策 86：IEEE double via JS Number） ----
fun avg(a: Rat, b: Rat): Rat = (a + b) / 2.0

// ---- P8：插值 + 命名参数（决策 84：位置参数填前 N、命名参数按名填充） ----
fun greet(name: Str, age: Nat): Str = "$name($age)"

@unpure fun main() {
print(greet(age = 4, name = "杏"))
print("avg=${avg(1.0, 2.0)} len=${len(LCons(1, LNil()))}")
print(joinAll(LCons(1, LCons(2, LNil()))))
}