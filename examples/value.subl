// ============================================================
// 值层端到端：算术、struct、enum、when 模式匹配、if、var/@mut、输出
// 预期 stdout（每行一个）：zero / nonzero / nonzero / nonzero / yes / no
// ============================================================

struct Point(x: Nat, y: Nat)

// 单表达式体：只写 `= 表达式`，不加花括号
fun add(a: Nat, b: Nat): Nat = a + b

fun classify(n: Nat): Str {
    return when(n) {
        0 -> "zero"
        else -> "nonzero"
    }
}

fun isPos(n: Int): Bool {
    return if (n < 0) { false() } else { true() }
}

fun boolToStr(b: Bool): Str {
    return when(b) {
        true -> "yes"
        false -> "no"
    }
}

fun main() {
    @mut var sum = 0
    sum = sum + add(2, 3)
    sum = sum + 1

    var p = Point(1, 2)

    unchecked print(classify(add(0, 0)))   // zero
    unchecked print(classify(add(2, 3)))   // nonzero
    unchecked print(classify(sum))         // nonzero
    unchecked print(classify(p.x))         // nonzero
    unchecked print(boolToStr(isPos(5)))   // yes
    unchecked print(boolToStr(isPos(-3)))  // no
}
