// ============================================================
// v1.0 P11 验收压测（v1.0补全计划.md §13；候选 A：JSON parser；决策 87）
// JSON parser —— 纯 .subl 编写，无任何 JS 混入，完全自包含（连 List 都自带，不依赖 stdlib）。
// 覆盖（§13.3-4）：字符串（charAt/substring/concat）、集合（自建 JList + 遍历）、错误处理（Ret）、
//       浮点 Rat、递归（解析器索引递归 + Json 树结构递归）、泛型约束（impl Show for Json）、
//       插值（P8）、命名参数（P8）、自动推理（unchecked.axiom = 0）。
// 停机说明：解析器索引递归（i → i+1）是数值递减，P9（决策 44）"语法子项"判定判不出，
//       按计划 §11.3 用 unchecked 前缀逃逸标注递归调用点（纯调用，不改纯度，axiom 0 次）；
//       Json 树遍历是构造子模式解构 → P9 结构递归判定放行（结构子项链路）。
// 相等比较统一前缀 ==(a,b) / !=(a,b)：`==` 禁止中缀（防与命题混淆）。
// 函数风格：块体尾表达式（return 只能出现在具名函数语句流，决策 75）。
// ============================================================

// ---------- 数据类型 ----------
class Show[T] { fun show(): Str }
enum JList[T] { JNil(), JCons(T, JList<T>) }
enum Json { JNull(), JBool(Bool), JNum(Rat), JStr(Str), JArr(JList<Json>), JObj(JList<Pair>) }
struct Pair(k: Str, v: Json)
enum Ret { Ok(Json, Nat), Fail(Str) }

// ---------- 自建列表遍历（结构递归于解构绑定，P9 放行：JCons 的 t 是 l 的结构子项） ----------
fun jLen[T](xs: JList<T>): Nat = when(xs) {
    JNil() -> 0
    JCons(_, t) -> 1 + jLen(t)
    _ -> 0
}
fun jFold[T, U](init: U, f: (T, U) => U, xs: JList<T>): U = when(xs) {
    JNil() -> init
    JCons(h, t) -> jFold(f(h, init), f, t)
    _ -> init
}
fun jRev[T](xs: JList<T>): JList<T> = jFold(JNil(), \(h, acc) => JCons(h, acc), xs)

// ---------- 字符辅助 ----------
fun isDigit(c: Str): Bool = ==(c, "0") | ==(c, "1") | ==(c, "2") | ==(c, "3") | ==(c, "4") | ==(c, "5") | ==(c, "6") | ==(c, "7") | ==(c, "8") | ==(c, "9")
fun isWs(c: Str): Bool = ==(c, " ") | ==(c, "\n") | ==(c, "\t") | ==(c, "\r")
fun isNumStart(c: Str): Bool = isDigit(c) | ==(c, "-")

fun skipWs(s: Str, i: Nat): Nat {
    if (isWs(charAt(s, i))) {
        unchecked var r = skipWs(s, i + 1)
        r
    } else { i }
}

// ---------- 字面量（null / true / false） ----------
fun parseNull(s: Str, i: Nat): Ret =
    if (==(substring(s, i, i + 4), "null")) { Ok(JNull(), i + 4) } else { Fail("期望 null @ " + toStr(i)) }

fun parseTrue(s: Str, i: Nat): Ret =
    if (==(substring(s, i, i + 4), "true")) { Ok(JBool(true), i + 4) } else { Fail("期望 true @ " + toStr(i)) }

fun parseFalse(s: Str, i: Nat): Ret =
    if (==(substring(s, i, i + 5), "false")) { Ok(JBool(false), i + 5) } else { Fail("期望 false @ " + toStr(i)) }

// ---------- 数字：扫描到非数字字符后 parseRat ----------
fun numEnd(s: Str, i: Nat): Nat {
    if (isDigit(charAt(s, i)) | ==(charAt(s, i), "-") | ==(charAt(s, i), "+") | ==(charAt(s, i), ".")) {
        unchecked var r = numEnd(s, i + 1)
        r
    } else { i }
}

fun parseNumber(s: Str, i: Nat): Ret {
    var e = numEnd(s, i)
    when(parseRat(substring(s, i, e))) {
        Some(v) -> Ok(JNum(v), e)
        None -> Fail("坏数字(从 " + toStr(i) + " 到 " + toStr(e) + ")")
    }
}

// ---------- 字符串：累积到未转义引号（递归入尾），\ 转义走 parseEscape ----------
fun parseStrBody(s: Str, i: Nat, acc: Str): Ret = when(charAt(s, i)) {
    "\"" -> Ok(JStr(acc), i + 1)
    "\\" -> parseEscape(s, i, acc)
    "" -> Fail("字符串未闭合 @ " + toStr(i))
    _ -> {
        unchecked var r = parseStrBody(s, i + 1, concat(acc, charAt(s, i)))
        r
    }
}

fun parseEscape(s: Str, i: Nat, acc: Str): Ret = when(charAt(s, i + 1)) {
    "\"" -> { unchecked var r = parseStrBody(s, i + 2, concat(acc, "\"")); r }
    "\\" -> { unchecked var r = parseStrBody(s, i + 2, concat(acc, "\\")); r }
    "n" -> { unchecked var r = parseStrBody(s, i + 2, concat(acc, "\n")); r }
    "t" -> { unchecked var r = parseStrBody(s, i + 2, concat(acc, "\t")); r }
    "r" -> { unchecked var r = parseStrBody(s, i + 2, concat(acc, "\r")); r }
    _ -> Fail("未知转义 @ " + toStr(i))
}

// ---------- 数组：元素用 JCons 累积，收尾 jRev 复原顺序 ----------
fun parseArr(s: Str, i: Nat, acc: JList<Json>): Ret {
    var j = skipWs(s, i)
    if (==(charAt(s, j), "]")) { Ok(JArr(jRev(acc)), j + 1) }
    else {
        var r = parseValue(s, j)
        when(r) {
            Ok(v, k) -> {
                var k2 = skipWs(s, k)
                if (==(charAt(s, k2), ",")) {
                    unchecked var r2 = parseArr(s, k2 + 1, JCons(v, acc))
                    r2
                } else { if (==(charAt(s, k2), "]")) { Ok(JArr(jRev(JCons(v, acc))), k2 + 1) } else { Fail("期望 , 或 ] @ " + toStr(k2)) } }
            }
            Fail(e) -> Fail(e)
        }
    }
}

// ---------- 对象：键 = 字符串（剥壳取 Str），值 = parseValue ----------
fun strOf(j: Json): Str = when(j) {
    JStr(x) -> x
    _ -> ""
}

fun parseObj(s: Str, i: Nat, acc: JList<Pair>): Ret {
    var j = skipWs(s, i)
    if (==(charAt(s, j), "}")) { Ok(JObj(jRev(acc)), j + 1) }
    else {
        var rk = parseStrBody(s, j + 1, "")
        when(rk) {
            Ok(kv, k) -> {
                var k2 = skipWs(s, k)
                if (!=(charAt(s, k2), ":")) { Fail("期望 : @ " + toStr(k2)) }
                else {
                    var rv = parseValue(s, k2 + 1)
                    when(rv) {
                        Ok(v, m) -> {
                            var m2 = skipWs(s, m)
                            var pr = Pair(strOf(kv), v)
                            if (==(charAt(s, m2), ",")) {
                                unchecked var r2 = parseObj(s, m2 + 1, JCons(pr, acc))
                                r2
                            } else { if (==(charAt(s, m2), "}")) { Ok(JObj(jRev(JCons(pr, acc))), m2 + 1) } else { Fail("期望 , 或 } @ " + toStr(m2)) } }
                        }
                        Fail(e) -> Fail(e)
                    }
                }
            }
            Fail(e) -> Fail(e)
        }
    }
}

// ---------- 调度：跳过空白后按首字符分派。parseAt 演示命名参数（P8 决策 84） ----------
fun parseAt(s: Str, i: Nat, ws: Bool): Ret = if (==(ws, true)) { parseValueAt(s, skipWs(s, i)) } else { parseValueAt(s, i) }
fun parseValue(s: Str, i: Nat): Ret = parseAt(s = s, ws = true, i = i)

fun parseValueAt(s: Str, j: Nat): Ret = when(charAt(s, j)) {
    "n" -> parseNull(s, j)
    "t" -> parseTrue(s, j)
    "f" -> parseFalse(s, j)
    "\"" -> parseStrBody(s, j + 1, "")
    "[" -> parseArr(s, j + 1, JNil())
    "{" -> parseObj(s, j + 1, JNil())
    _ -> if (isNumStart(charAt(s, j))) { parseNumber(s, j) } else { Fail("期望值 @ " + toStr(j)) }
}

// ---------- Json 树结构递归（P9 判定放行：arr/pair 解构绑定是节点的结构子项） ----------
fun countNodes(j: Json): Nat = when(j) {
    JArr(l) -> 1 + countList(l)
    JObj(p) -> 1 + countPairs(p)
    _ -> 1
}
fun countList(l: JList<Json>): Nat = when(l) {
    JNil() -> 0
    JCons(h, t) -> countNodes(h) + countList(t)
    _ -> 0
}
fun countPairs(p: JList<Pair>): Nat = when(p) {
    JNil() -> 0
    JCons(pr, t) -> 2 + countNodes(pr.v) + countPairs(t)
    _ -> 0
}

// ---------- 序列化（show）：输出可读 JSON ----------
fun showFull(j: Json): Str = when(j) {
    JNull() -> "null"
    JBool(b) -> if (b) { "true" } else { "false" }
    JNum(n) -> toStr(n)
    JStr(x) -> concat("\"", concat(x, "\""))
    JArr(l) -> showArr(l)
    JObj(p) -> showObj(p)
    _ -> "?"
}

fun showArr(l: JList<Json>): Str {
    var inner = jFold("", \(x, acc) => if (==(acc, "")) { showFull(x) } else { concat(acc, concat(",", showFull(x))) }, l)
    concat("[", concat(inner, "]"))
}

fun showPair(p: Pair): Str = concat("\"", concat(p.k, concat("\"", concat(":", showFull(p.v)))))

fun showObj(ps: JList<Pair>): Str {
    var inner = jFold("", \(x, acc) => if (==(acc, "")) { showPair(x) } else { concat(acc, concat(",", showPair(x))) }, ps)
    concat("{", concat(inner, "}"))
}

// ---------- 泛型约束（P4）：impl Show for Json，展示字典槽 + 方法调用 ----------
impl Show for Json { fun show(): Str = showFull(self) }

fun showAll[T: Show](xs: JList<T>): Str = jFold("", \(x, acc) => concat(acc, x.show()), xs)

// ---------- 顶入口 ----------
fun parse(s: Str): Ret = parseValue(s, 0)

// ---------- 验收用例（@unpure：print 是内建 IO；字符串统一插值，P8） ----------
@unpure fun main() {
var js1 = "{\"name\": \"alice\", \"age\": 30, \"pi\": 3.14, \"ok\": true, \"none\": null, \"tags\": [\"a\", \"b\", 1], \"meta\": {\"x\": 1.5, \"y\": [true, false]}}"
when(parse(js1)) {
    Ok(v, k) -> {
        var n = countNodes(v)
        print("完整对象（节点数 $n）：${showFull(v)}")
    }
    Fail(e) -> print("ERR: $e")
}
when(parse("[1, 2.5, \"three\", null, true, [4, 5], {}]")) {
    Ok(v, _) -> print("混合数组：${showFull(v)}")
    Fail(e) -> print("ERR: $e")
}
when(parse("{\"a\": \"x\\\\ny\"}")) {
    Ok(v, _) -> print("转义字符串：${showFull(v)}")
    Fail(e) -> print("ERR: $e")
}
when(parse("{\"bad\": }")) {
    Ok(v, _) -> print("不应成功")
    Fail(e) -> print("ERR-EX: $e")
}
when(parse("[-2.5, 0, \"\", 100.0]")) {
    Ok(v, _) -> print("数字与空串：${showFull(v)}")
    Fail(e) -> print("ERR: $e")
}
when(parse("{\"a\": [1, 2], \"b\": {\"c\": \"d\"}}")) {
    Ok(v, _) -> print("约束show=${v.show()} 字典=${autonomous(v)}")
    Fail(e) -> print("ERR: $e")
}
}

// ---------- 泛型约束验收：showAll 需要 T: Show 字典（自动推理从 impl 补全） ----------
fun autonomous(v: Json): Str = showAll(JCons(v, JNil()))