// ============================================================
// Sublimation（凝华）语言 v2.0 示例：学生成绩统计
// 模块结构：show/ 为编译入口根目录（根模块 = show.subl），show/stdlib/ 为自动挂载的标准库。
// 运行：show\run.bat（compile show 目录 -> show.js，运行并输出 show.log）
// 功能：读取 students.json（含学生姓名与语数英成绩）→ 内建 JSON 解析（jsonParse/jsonGet/jsonToList）
//       → 计算每人总分/平均分、班级各科平均分、最高/最低总分。
// v2.0 基本库亮点：JSON 内建编译成 JS 原生（JSON.parse 等），坏 JSON 返回 None 而非异常（空安全）；
//       List 底层数组化——jsonToList 零转换（JSON 数组=JS 数组），stdlib 的 map/fold/forEach
//       编译成 JS 原生数组方法（.map/.reduce/.forEach）。
// 覆盖特性：P3 IO（readFile）+ P5 Result 错误处理 + P8 字符串插值 + v2.0 内建 JSON + 空安全 Optional
//       + 接收者风格 stdlib 方法（map/fold/forEach）+ 模式解构（when Ok/Err、Some/None）。
// ============================================================

// ---------- 内建 JSON 访问辅助（Optional 空安全解构；失败按缺省值） ----------
// 对象字段 -> Optional[Json]（字段缺失返回 None）
fun fieldOf(j: Json, k: Str): Optional[Json] = jsonGet(j, k)

// Optional[Json] -> Str（非字符串/缺失一律 "?"）
fun optStr(o: Optional[Json]): Str = when(o) {
    Some(v) -> when(jsonStr(v)) { Some(s) -> s  None -> "?" }
    None -> "?"
}

// Optional[Json] -> Rat（非数值/缺失一律 0）
fun optNum(o: Optional[Json]): Rat = when(o) {
    Some(v) -> when(jsonNum(v)) { Some(n) -> n  None -> 0.0 }
    None -> 0.0
}

// 学生姓名（对象字段 "name"）
fun nameOf(j: Json): Str = optStr(fieldOf(j, "name"))

// 从学生对象取某一科成绩（chinese/math/english）
fun subjectOf(j: Json, key: Str): Rat = optNum(fieldOf(j, key))

// ---------- 统计 ----------
// 单人总分 = 语文 + 数学 + 英语
fun totalOf(j: Json): Rat = subjectOf(j, "chinese") + subjectOf(j, "math") + subjectOf(j, "english")

// 单人平均（/ 内建恒返回 Rat）
fun avgOf(j: Json): Rat = totalOf(j) / 3.0

// 两数较大/较小
fun maxOf2(a: Rat, b: Rat): Rat = if (a > b) { a } else { b }
fun minOf2(a: Rat, b: Rat): Rat = if (a < b) { a } else { b }

// 全班某一科总和
fun sumSubj(xs: List[Json], key: Str): Rat = xs.fold(0.0) { j, acc -> acc + subjectOf(j, key) }
fun sumTotal(xs: List[Json]): Rat = xs.fold(0.0) { j, acc -> acc + totalOf(j) }
fun avgSubj(xs: List[Json], key: Str): Rat = sumSubj(xs, key) / toRat(xs.listLength())

// 最高/最低总分（P9 结构递归于 List 的 Cons 尾；min 用首元素做初值，杜绝 0 兜底）
fun maxTotal(xs: List[Json]): Rat = when(xs) {
    Cons(h, t) -> maxOf2(totalOf(h), maxTotal(t))
    _ -> 0.0
}
fun minRest(xs: List[Json], m: Rat): Rat = when(xs) {
    Cons(h, t) -> minRest(t, minOf2(m, totalOf(h)))
    _ -> m
}
fun minTotal(xs: List[Json]): Rat = when(xs) {
    Cons(h, t) -> minRest(t, totalOf(h))
    _ -> 0.0
}

// 单人成绩摘要（插值 P8）
fun lineOf(j: Json): Str =
    concat("  ", concat(nameOf(j), concat(": 语/数/英 = ",
        concat(toStr(subjectOf(j, "chinese")), concat("/",
        concat(toStr(subjectOf(j, "math")), concat("/",
        concat(toStr(subjectOf(j, "english")), concat("   总分 = ",
        concat(toStr(totalOf(j)), concat("  平均 = ", toStr(avgOf(j)))))))))))))

// ---------- main：读文件 -> 内建 JSON 解析 -> 统计 ----------
@unpure
fun main() {
    var r = readFile("students.json")
    when(r) {
        Ok(content) -> when(jsonParse(content)) {
            Some(root) -> {
                var cls = optStr(fieldOf(root, "class"))
                var tch = optStr(fieldOf(root, "teacher"))
                when(fieldOf(root, "students")) {
                    Some(s) -> when(jsonToList(s)) {
                        Some(studs) -> {
                            print("班级: $cls  教师: $tch  学生数: ${studs.listLength()}")
                            print("--- 个人成绩 ---")
                            studs.forEach({ j -> print(lineOf(j)) })
                            print("--- 班级统计 ---")
                            var cAvg = avgSubj(studs, "chinese")
                            var mAvg = avgSubj(studs, "math")
                            var eAvg = avgSubj(studs, "english")
                            print("语文平均 = $cAvg  数学平均 = $mAvg  英语平均 = $eAvg")
                            print("总分平均 = ${sumTotal(studs) / toRat(studs.listLength())}  最高总分 = ${maxTotal(studs)}  最低总分 = ${minTotal(studs)}")
                        }
                        None -> print("students 字段不是数组")
                    }
                    None -> print("students 字段缺失")
                }
            }
            None -> print("JSON 解析失败")
        }
        Err(e) -> print("读取 students.json 失败: $e")
    }
}