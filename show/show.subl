// ============================================================
// Sublimation（凝华）语言 v2.0 示例：学生成绩统计
// 模块结构：show/ 为编译入口根目录（根模块 = show.subl），
//   show/stdlib/ 为自动挂载的标准库，show/jsonparser.subl 为 JSON parser。
// 运行：show\run.bat（compile show 目录 -> show.js，运行并输出 show.log）
// 功能：读取 students.json（含学生姓名与语数英成绩）→ 解析 JSON
//       → 计算每人总分/平均分、班级各科平均分、最高/最低总分。
// 覆盖特性：P3 IO（readFile）+ P5 Result 错误处理 + P7 合一/泛型反推
//       + P8 字符串插值 + JSON parser（P11 产物移植）+ P9 结构递归放行
//       + 接收者风格 stdlib 方法（fold/map）+ 模式解构（when Ok/Err、
//         JCons/JObj）+ 命名参数（parseAt）。
// ============================================================

// ---------- JSON 提取辅助（从解析后的 Json 树取值） ----------
// 在对象字段表里按 key 取值；找不到返回 JNull
fun objField(pairs: JList[Pair], key: Str): Json = when(pairs) {
    JNil() -> JNull()
    JCons(pr, t) -> if (==(pr.k, key)) { pr.v } else { objField(t, key) }
    _ -> JNull()
}

// Json -> 数值（非 JNum 一律按 0 处理）
fun numOf(j: Json): Rat = when(j) {
    JNum(n) -> n
    _ -> 0.0
}

// 从学生对象取某一科成绩（name/chinese/math/english）
fun subjectOf(j: Json, key: Str): Rat = when(j) {
    JObj(p) -> numOf(objField(p, key))
    _ -> 0.0
}

// 学生姓名（对象字段 "name"）
fun nameOf(j: Json): Str = when(j) {
    JObj(p) -> strOf(objField(p, "name"))
    _ -> "?"
}

// ---------- 统计原语（构造子解构 → P9 结构递归放行） ----------
// 单人总分 = 语文 + 数学 + 英语
fun totalOf(j: Json): Rat = subjectOf(j, "chinese") + subjectOf(j, "math") + subjectOf(j, "english")

// 单人平均（/ 内建恒返回 Rat）
fun avgOf(j: Json): Rat = totalOf(j) / 3.0

// 两数较大/较小
fun maxOf2(a: Rat, b: Rat): Rat = if (a > b) { a } else { b }
fun minOf2(a: Rat, b: Rat): Rat = if (a < b) { a } else { b }

// 全班某一科总和 / 总分总和 / 平均
fun sumSubj(xs: JList[Json], key: Str): Rat = jFold(0.0, { j, acc -> acc + subjectOf(j, key) }, xs)
fun sumTotal(xs: JList[Json]): Rat = jFold(0.0, { j, acc -> acc + totalOf(j) }, xs)
fun avgSubj(xs: JList[Json], key: Str): Rat = sumSubj(xs, key) / toRat(jLen(xs))

// 最高/最低总分（累加器递归于 JCons 的 t，P9 放行；min 用首元素做初值，杜绝 0 兜底）
fun maxTotal(xs: JList[Json]): Rat = when(xs) {
    JCons(h, t) -> maxOf2(totalOf(h), maxTotal(t))
    _ -> 0.0
}
fun minRest(xs: JList[Json], m: Rat): Rat = when(xs) {
    JCons(h, t) -> minRest(t, minOf2(m, totalOf(h)))
    _ -> m
}
fun minTotal(xs: JList[Json]): Rat = when(xs) {
    JCons(h, t) -> minRest(t, totalOf(h))
    _ -> 0.0
}

// 单人成绩摘要（插值 P8）
fun lineOf(j: Json): Str =
    concat("  ", concat(nameOf(j), concat(": 语/数/英 = ",
        concat(toStr(subjectOf(j, "chinese")), concat("/",
        concat(toStr(subjectOf(j, "math")), concat("/",
        concat(toStr(subjectOf(j, "english")), concat("   总分 = ",
        concat(toStr(totalOf(j)), concat("  平均 = ", toStr(avgOf(j)))))))))))))

// 逐人打印（顶层递归；构造子解构 t 是结构子项 → P9 放行）
@unpure
fun printAll(l: JList[Json]): Null = when(l) {
    JCons(h, t) -> { print(lineOf(h)); printAll(t) }
    _ -> null
}

// ---------- main：读文件 -> 解析 -> 统计 ----------
@unpure
fun main() {
    var r = readFile("students.json")
    when(r) {
        Ok(content) -> {
            when(parse(content)) {
                JOk(root, _) -> when(root) {
                    JObj(pairs) -> {
                        var cls = strOf(objField(pairs, "class"))
                        var tch = strOf(objField(pairs, "teacher"))
                        var studs = when(objField(pairs, "students")) {
                            JArr(l) -> l
                            _ -> JNil()
                        }
                        print("班级: $cls  教师: $tch  学生数: ${jLen(studs)}")
                        print("--- 个人成绩 ---")
                        printAll(studs)
                        print("--- 班级统计 ---")
                        var cAvg = avgSubj(studs, "chinese")
                        var mAvg = avgSubj(studs, "math")
                        var eAvg = avgSubj(studs, "english")
                        print("语文平均 = $cAvg  数学平均 = $mAvg  英语平均 = $eAvg")
                        print("总分平均 = ${sumTotal(studs) / toRat(jLen(studs))}  最高总分 = ${maxTotal(studs)}  最低总分 = ${minTotal(studs)}")
                    }
                    _ -> print("JSON 根不是对象")
                }
                JFail(e) -> print("JSON 解析失败: $e")
            }
        }
        Err(e) -> print("读取 students.json 失败: $e")
    }
}