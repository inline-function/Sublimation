// ============================================================
// Sublimation（凝华）语言 v2.0 特性展示（Kotlin 风格语法）
// 模块结构：show/ 为编译入口根目录（根模块 = show.subl），
//   show/stdlib/ 为自动挂载的标准库。
// 运行：show\run.bat（compile show 目录 -> show.js，运行并输出 show.log）
// 覆盖特性：
//   v2.0：同名方法跨容器**重载**（size/map/filter/contains 按接收者路由）+
//         集合 API 扩展（sum/maxNat/minNat/take/drop/union/intersect/keys/values…）+
//         Optional/Result 工具（map/flatMap/filter/orElse…）→ JS 按首参标签唯一化命名
//   v2.0 三大系统：**空安全**（T?/?:/>:/?T 智能转换）·
//         **可变性控制**（immutable<T>/untouch<param> 自然命题）· **异步**（@async/Task/Channel/sleep）
//   v1.1 语法：if (cond) 强制括号 / a == b 中缀 / { x -> } lambda + 尾随 lambda /
//              表达式体返回类型推导 / 块式显式 return / 接收者风格 xs.map {} /
//              变量元组解构 `var (b, c) = a`（决策 91 声明版）/ 有标注 lambda 参数类型反推
//   型类：class Show + impl（Grade/Student）+ 字典自动推理
//   模式：when 解构 / 守卫 / else 兜底；元组；命题前后件
// ============================================================

// ---------- 1. 学生成绩（结构体 + 列表 + 高阶） ----------
struct Student(name: Str, scores: List[Nat])
enum Grade { A(), B(), C(), D() }

fun gradeOf(n: Rat): Grade = when(n) {
    _ if n >= 90.0 -> A()
    _ if n >= 80.0 -> B()
    _ if n >= 70.0 -> C()
    _ -> D()
}

fun avgOf(s: Student): Rat {
    var n = s.scores.listLength()
    if (n == 0) { return 0.0 }
    return s.scores.fold(0) { x, acc -> acc + x } / n
}

// ---------- 2. 类型类 Show（自有类型 impl + 字典自动推理） ----------
class Show[T] { fun show(): Str }
impl Show for Grade { fun show(): Str = when(self) { A() -> "A"; B() -> "B"; C() -> "C"; D() -> "D"; _ -> "?" } }
impl Show for Student { fun show(): Str = concat(self.name, concat(" 分数: [", concat(showNums(self.scores), "]"))) }

// Nat 列表 -> 逗号串（接收者式 fold + 尾随 lambda）
fun showNums(xs: List[Nat]): Str = xs.fold("") { x, acc ->
    if (acc == "") { toStr(x) } else { concat(acc, concat(",", toStr(x))) }
}

// ---------- 3. 元组 / 解构 / 命名参数 ----------
fun minmax2(p: (Nat, Nat)): (Nat, Nat) = when(p) {
    (a, b) -> if (a < b) { (a, b) } else { (b, a) }
    _ -> p
}
fun greet(name: Str, exclaim: Str): Str = concat("Hello, ", concat(name, exclaim))

// ---------- 4. 命题前后件（unchecked.axiom + 自动供给） ----------
// v1.1（主人拍板）：`:` 前是上文（前置，调用需已证明）、后是下文（后置，调用产出）；
// 返回类型可省略——giveP 后置 p 写 `: <p>`，takeP 前置 p 写 `<p>` 并省略 () 与返回类型
fun giveP: <p> { unchecked.axiom[p] }
fun takeP<p> {}

// ============================================================
// v2.0 三大系统展示
// ============================================================

// ---------- 空安全系统：T? / ?: / >: / ?T 智能转换 ----------
struct Point(x: Nat, y: Nat)

// T? = Optional[T]；?: 空替代（Some/None）—— 复用 v1.1 Optional 工具
@unpure fun nullSafety() {
    var age: Nat? = Some(20)
    print("空安全 elvis(Some) = ${age ?: 0}")
    var none: Optional[Nat] = None()
    print("空安全 elvis(None) = ${none ?: 7}")
    var maybe: Optional[Str] = Some("sam")
    var nm: Str = maybe ?: "anonymous"
    print("空安全 elvis(Str) = $nm")
    // >: 类型断言 + 收窄（对已解包值；运行时 __isa 命中 -> Some）
    var n: Nat = 9
    var cast = n >: Nat
    print("空安全 safeCast = ${cast.getOrElse(0)}")
}

// 智能转换：if (o ? Point) 分支内 Any 收窄为 Point（决策 88-92 余项）
@unpure fun smartCast(o: Any) {
    if (o ? Point) {
        var p: Point = o
        print("空安全 smart cast: p.x = ${p.x}")
    }
}

// ---------- 可变性控制：immutable<T> / untouch<param> 自然命题 ----------
// Point 无 @mut 字段且字段类型 immutable -> 编译器自动注入 immutable<Point>，
// 后置条件 <immutable<Point>> 可证明（不触发 E-POST-UNPROVEN）
fun pointGuard(p: Point) : Null <immutable<Point>> {}
// 非 @mut 形参自动注入 untouch<param>：函数体未改 x 则可证明
fun sanitize(x: Nat) : Null <untouch<x>> {}

// ---------- 异步：@async / Task / Channel / sleep 挂起点 ----------
// @async 内 sleep/send/receive 为挂起点，自动 await（SUSP-2）；Task 体天然 async
@unpure @async fun producer(ch: Channel[Nat]) {
    ch.send(1)
    sleep(5)
    ch.send(2)
    ch.close()                 // CH-6：close 后 send 才报 E-CHANNEL-CLOSED
}

// CH-5 + 阶段5 智能转换：if (!ch.isClosed()) 分支内 receive 返回 T（解包）
@unpure @async fun asyncDemo() {
    var ch: Channel[Nat] = Channel<Nat>(2)   // 有缓冲通道（值位尖括号）
    var t = Task { producer(ch) }            // 创建不启动
    t.start()
    if (t.isAlive()) { print("异步 task alive...") }
    t.join()                                 // 挂起等待
    print("异步 task joined")

    var ch2: Channel[Nat] = Channel<Nat>(1)
    ch2.send(7)
    if (!ch2.isClosed()) {
        var v: Nat = ch2.receive()           // 本地未关闭 -> 智能转换解包为 Nat
        print("异步 channel receive(smart) = ${v}")
    }
}

// ---------- main ----------
@unpure
fun main() {
    var xs = stdlib.range(1, 5)
    print("range(1,5) 长度 = ${xs.listLength()}")
    var doubled = xs.map { x -> x * 2 }
    print("map 双倍 = ${showNums(doubled)}")
    var evens = xs.filter { x -> x % 2 == 0 }
    print("filter 偶数 = ${showNums(evens)}")
    var total = xs.fold(0) { x, acc -> acc + x }
    print("fold 求和 = $total")
    var s = Student("Alice", stdlib.Cons(90, stdlib.Cons(80, stdlib.Cons(70, stdlib.Nil()))))
    print("学生 = ${s.show()}")
    print("平均分 = ${avgOf(s)}  评级 = ${gradeOf(avgOf(s)).show()}")
    var mm = minmax2((4, 2))
    when(mm) {
        (lo, hi) -> print("元组解构 minmax = $lo..$hi")
        _ -> print("?")
    }
    var g = greet(exclaim = "!", name = "Bob")
    print("命名参数乱序 = $g")
    // v1.1 新特性：Set / Map（独立枚举）+ 方法式调用（@mut 声明可重绑定）
    @mut var grades: Set[Nat] = stdlib.setEmpty()
    grades = grades.add(3)
    grades = grades.add(7)
    print("集合 contains(3) = ${grades.contains(3)}  size = ${grades.size()}")
    @mut var phone: Map[Str, Nat] = stdlib.mapEmpty()
    phone = phone.put("Alice", 12345)
    var alice = phone.get("Alice").getOrElse(0)
    print("表 get(Alice) = $alice  size = ${phone.size()}")
    // v2.0 基本库：重载同名方法（接收者路由）+ 新集合 API
    phone = phone.put("Bob", 555)
    var hasBob = phone.containsKey("Bob")
    var ks = phone.keys()
    var vs = phone.values()
    var kstr = ks.joinToString(", ")
    var vstr = vs.joinToString(", ")
    print("表 containsKey(Bob) = $hasBob  keys = $kstr  values = $vstr")
    print("List sum = ${xs.sum()}  max = ${xs.maxNat().getOrElse(0)}  min = ${xs.minNat().getOrElse(0)}")
    var big = grades.add(9)
    print("并集 size = ${big.union(grades).size()}  交集 size = ${big.intersect(grades).size()}")
    var maybe: Optional[Nat] = Some(6)
    var doubledOpt = maybe.map { x -> x * 2 }
    print("Optional.map = ${doubledOpt.getOrElse(0)}  isSome = ${maybe.isSome()}")
    giveP()
    takeP()
    print("命题供给 = OK")
    // ===== v2.0 三大系统 =====
    nullSafety()
    smartCast(Point(1, 2))
    pointGuard(Point(1, 2))
    sanitize(3)
    print("可变性自然命题 (immutable/untouch) = OK")
    asyncDemo()
    //变量上的解构
    var a = (1,2)
    var (b,c) = a
    print("元组解构 = $b..$c")
    //默认单参
    var lambda : (Nat)=>Nat = { x -> x + 1 }
    print("lambda(41) = ${lambda(41)}")
}