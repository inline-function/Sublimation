// stdlib.nat —— 自然数算术（依赖：logic、order）
//
// 依据：Peano 公理 + 算术法则。本文件把《基本库实现文档》的 @axiom 定律落地为
// @theorem 无体声明（签名即定理、登记定理空间、编译期擦除）。
// 注意（证明器能力边界）：项级合一只支持原子命题直接位与整树 toString 级匹配，
// 故 a + b 形态的递归律只对**同形目标**命中；具体常量算术（如 1 + 1 = 2）
// 由 ArithProve 常量折叠直接证明，无需定理。

// ---------- Peano 公理 ----------
// 依据：0 是 Nat（字面量类型事实）。
@theorem
fun `nat zero`[d]: Null <0 : Nat>
// 依据：Nat 后继封闭（n + 1 : Nat）。
@theorem
fun `nat succ`[n]: Null <(n + 1) : Nat>
// 依据：Nat 非负（与 logic 的 nat nonneg 同形，二选一命中）。
@theorem
fun `nat nonneg`[n]: Null <n >= 0>

// ---------- 加法法则 ----------
// 依据：交换律（Peano 可证；此处作定义性定律登记）。
@theorem
fun `add comm`[a, b]: Null <(a + b) = (b + a)>
// 依据：结合律。
@theorem
fun `add assoc`[a, b, c]: Null <((a + b) + c) = (a + (b + c))>
// 依据：0 是加法单位元。
@theorem
fun `add zero`[a]: Null <(a + 0) = a>
// 依据：加法消去律。
@theorem
fun `add cancel`[a, b, c]: Null <((a + c) = (b + c)) -> (a = b)>

// ---------- 乘法法则 ----------
// 依据：交换律。
@theorem
fun `mul comm`[a, b]: Null <(a * b) = (b * a)>
// 依据：结合律。
@theorem
fun `mul assoc`[a, b, c]: Null <((a * b) * c) = (a * (b * c))>
// 依据：1 是乘法单位元。
@theorem
fun `mul one`[a]: Null <(a * 1) = a>
// 依据：0 是乘法零元。
@theorem
fun `mul zero`[a]: Null <(a * 0) = 0>
// 依据：左分配律。
@theorem
fun `distrib`[a, b, c]: Null <(a * (b + c)) = ((a * b) + (a * c))>

// ---------- 序（Nat 专用） ----------
// 依据：≤ 自反（Nat 上成立）。
@theorem
fun `le refl nat`[a]: Null <a <= a>
// 依据：≤ 传递。
@theorem
fun `le trans nat`[a, b, c]: Null <(a <= b) & (b <= c) -> (a <= c)>
// 依据：≤ 反对称。
@theorem
fun `le antisym nat`[a, b]: Null <(a <= b) & (b <= a) -> (a = b)>
// 依据：0 是 Nat 的最小元。
@theorem
fun `zero le`[a]: Null <0 <= a>
// 依据：加法保序。
@theorem
fun `add le left`[a, b, c]: Null <(a <= b) -> ((a + c) <= (b + c))>

// ---------- 实用函数（值层，纯函数不可变） ----------

// 依据：前驱函数，0 的前驱约定为 0（饱和减法）。
fun pred(n: Nat): Nat = if (n == 0) { 0 } else { n - 1 }

// 依据：零判定。
fun isZero(n: Nat): Bool = n == 0

// 依据：偶数判定——对 n - 2 数值严格递归（停机性由「数值递减」通道认可）。
fun isEven(n: Nat): Bool = if (n <= 1) { n == 0 } else { isEven(n - 2) }

// 依据：奇数判定 = 偶数判定之否。
fun isOdd(n: Nat): Bool = !(isEven(n))

// 依据：自然数幂——对指数严格递减递归。
fun natPow(a: Nat, b: Nat): Nat = if (b == 0) { 1 } else { a * natPow(a, b - 1) }

// 依据：阶乘——对 n 严格递减递归。
fun factorial(n: Nat): Nat = if (n <= 1) { 1 } else { n * factorial(n - 1) }
