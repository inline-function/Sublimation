// 序关系类型类 Ord 定义在 stdlib.order（math 依赖）；成员为方法式（接收者即左操作数）。
// 本文件只管容器（Functor/Foldable/Monad 及 List/Optional/Result/Set/Map/Tuple）。

class Functor[F[_]] {
    @axiom fun map[A, B](fa: F[A], f: (A) => B): F[B]
}

class Foldable[F[_]] {
    @axiom fun fold[A, R](fa: F[A], init: R, f: (R, A) => R): R
}

class Monad[F[_]] : Functor[F] {
    @axiom fun pure[A](x: A): F[A]
    @axiom fun flatMap[A, B](fa: F[A], f: (A) => F[B]): F[B]
}


fun size[F[_]: Foldable, A](fa: F[A]): Nat
    <$ = fold(fa, 0, { acc, _ => acc + 1 })>
    = fold(fa, 0, { acc, _ => acc + 1 })

@axiom fun isEmpty[F[_]: Foldable, A](fa: F[A]): Bool
    <$ ↔ size(fa) = 0>
    = size(fa) == 0

@axiom fun contains[F[_]: Foldable, A](fa: F[A], x: A): Bool
    <$ ↔ ∃a. a ∈ fa ∧ a = x>
    = fold(fa, false, { acc, y => acc || y == x })

@axiom fun count[F[_]: Foldable, A](fa: F[A], p: (A) => Bool): Nat
    <$ ≤ size(fa)>
    = fold(fa, 0, { acc, x => if (p(x)) { acc + 1 } else { acc } })

@axiom fun any[F[_]: Foldable, A](fa: F[A], p: (A) => Bool): Bool
    <$ ↔ ∃a. a ∈ fa ∧ p(a)>
    = fold(fa, false, { acc, x => acc || p(x) })

@axiom fun all[F[_]: Foldable, A](fa: F[A], p: (A) => Bool): Bool
    <$ ↔ ∀a. a ∈ fa → p(a)>
    = fold(fa, true, { acc, x => acc && p(x) })

fun find[F[_]: Foldable, A](fa: F[A], p: (A) => Bool): Optional[A]
    <isSome($) → ∃a. a ∈ fa ∧ p(a) ∧ a = getOrElse($, a),
     isNone($) → ∀a. a ∈ fa → ¬p(a)>
    = fold(fa, None(), { acc, x => when(acc) {
        is Some(_) -> acc
        None -> if (p(x)) { Some(x) } else { None() }
    } })

@axiom fun forEach[F[_]: Foldable, A](fa: F[A], f: @impure (A) => Null): Null
    <∀a. a ∈ fa → f 被调用过 a>
    = fold(fa, null, { _, x => f(x) })


enum List[T] {
    Nil()
    Cons(T, List[T])
}

impl Functor[List] {
    @axiom fun map[A, B](fa: List[A], f: (A) => B): List[B]
        <size($) = size(fa),
         ∀i. i < size(fa) → get($, i) = f(get(fa, i))>
        = when(fa) {
            Nil -> Nil()
            is Cons(h, t) -> Cons(f(h), map(t, f))
        }
}

impl Foldable[List] {
    @axiom fun fold[A, R](fa: List[A], init: R, f: (R, A) => R): R
        <(fa = Nil()) → ($ = init),
         (∀h t. fa = Cons(h, t)) → ($ = fold(t, f(init, h), f))>
        = when(fa) {
            Nil -> init
            is Cons(h, t) -> fold(t, f(init, h), f)
        }
}

impl Monad[List] {
    @axiom fun pure[A](x: A): List[A]
        <size($) = 1, get($, 0) = x>
        = Cons(x, Nil())

    @axiom fun flatMap[A, B](fa: List[A], f: (A) => List[B]): List[B]
        <size($) = sum(map(fa, { a => size(f(a)) }))>
        = when(fa) {
            Nil -> Nil()
            is Cons(h, t) -> append(f(h), flatMap(t, f))
        }
}

@axiom fun emptyList[T](): List[T]
    <size($) = 0>
    = Nil()

@axiom fun cons[T](x: T, xs: List[T]): List[T]
    <size($) = size(xs) + 1,
     get($, 0) = x,
     ∀i. 0 < i ∧ i ≤ size(xs) → get($, i) = get(xs, i - 1)>
    = Cons(x, xs)

fun listOf[T](@list items: T): List[T]
    <size($) = size(items)>
    = items

@axiom fun head[T](xs: List[T]): Optional[T]
    <size(xs) = 0 → $ = None(),
     size(xs) > 0 → $ = Some(get(xs, 0))>
    = when(xs) {
        Nil -> None()
        is Cons(h, _) -> Some(h)
    }

@axiom fun last[T](xs: List[T]): Optional[T]
    <size(xs) = 0 → $ = None(),
     size(xs) > 0 → $ = Some(get(xs, size(xs) - 1))>
    = when(xs) {
        Nil -> None()
        is Cons(h, Nil) -> Some(h)
        is Cons(_, t) -> last(t)
    }

@axiom fun elementAt[T](xs: List[T], i: Nat): Optional[T]
    <i ≥ size(xs) → $ = None(),
     i < size(xs) → $ = Some(get(xs, i))>
    = when(xs) {
        Nil -> None()
        is Cons(h, t) -> if (i == 0) { Some(h) } else { elementAt(t, i - 1) }
    }

@axiom fun get[T](xs: List[T], i: Nat)<i < size(xs)>: T
    <$ = elementAt(xs, i) 的内部值>
    = when(elementAt(xs, i)) {
        is Some(v) -> v
        None -> panic()
    }

@axiom fun firstOr[T](xs: List[T], d: T): T
    <size(xs) = 0 → $ = d,
     size(xs) > 0 → $ = get(xs, 0)>
    = getOrElse(head(xs), d)

@axiom fun indexOf[T](xs: List[T], x: T): Optional[Nat]
    <isSome($) → get(xs, getOrElse($, 0)) = x ∧ ∀i. i < getOrElse($, 0) → get(xs, i) ≠ x,
     isNone($) → ∀i. i < size(xs) → get(xs, i) ≠ x>
    = when(xs) {
        Nil -> None()
        is Cons(h, t) ->
            if (h == x) { Some(0) }
            else { when(indexOf(t, x)) {
                is Some(n) -> Some(n + 1)
                None -> None()
            } }
    }

@axiom fun append[T](xs: List[T], ys: List[T]): List[T]
    <size($) = size(xs) + size(ys),
     ∀i. i < size(xs) → get($, i) = get(xs, i),
     ∀i. size(xs) ≤ i ∧ i < size(xs) + size(ys) → get($, i) = get(ys, i - size(xs))>
    = when(xs) {
        Nil -> ys
        is Cons(h, t) -> Cons(h, append(t, ys))
    }

@axiom fun reverse[T](xs: List[T]): List[T]
    <size($) = size(xs),
     ∀i. i < size(xs) → get($, i) = get(xs, size(xs) - 1 - i)>
    = when(xs) {
        Nil -> Nil()
        is Cons(h, t) -> append(reverse(t), Cons(h, Nil()))
    }

@axiom fun take[T](xs: List[T], n: Nat): List[T]
    <size($) = min(n, size(xs)),
     ∀i. i < size($) → get($, i) = get(xs, i)>
    = when(xs) {
        Nil -> Nil()
        is Cons(h, t) ->
            if (n == 0) { Nil() }
            else { unchecked var r = take(t, n - 1); Cons(h, r) }
    }

@axiom fun drop[T](xs: List[T], n: Nat): List[T]
    <size($) = size(xs) - min(n, size(xs)),
     ∀i. i < size($) → get($, i) = get(xs, i + min(n, size(xs)))>
    = when(xs) {
        Nil -> Nil()
        is Cons(h, t) ->
            if (n == 0) { xs }
            else { unchecked var r = drop(t, n - 1); r }
    }

@axiom fun clear[T](xs: List[T]): List[T]
    <size($) = 0>
    = Nil()

@axiom fun filter[T](xs: List[T], p: (T) => Bool): List[T]
    <size($) ≤ size(xs),
     ∀i. i < size($) → p(get($, i)),
     ∀i. i < size($) → ∃j. j < size(xs) ∧ get($, i) = get(xs, j)>
    = when(xs) {
        Nil -> Nil()
        is Cons(h, t) -> if (p(h)) { Cons(h, filter(t, p)) } else { filter(t, p) }
    }

@axiom fun distinct[T](xs: List[T]): List[T]
    <size($) ≤ size(xs),
     ∀i. i < size($) → ∃j. j < size(xs) ∧ get($, i) = get(xs, j),
     ∀i j. i < size($) ∧ j < size($) ∧ i ≠ j → get($, i) ≠ get($, j)>
    = when(xs) {
        Nil -> Nil()
        is Cons(h, t) -> if (contains(t, h)) { distinct(t) } else { Cons(h, distinct(t)) }
    }

@axiom fun sortBy[T](xs: List[T], f: (T, T) => Bool): List[T]
    <size($) = size(xs),
     ∀i. i + 1 < size($) → f(get($, i), get($, i + 1)),
     ∀i. i < size($) → ∃j. j < size(xs) ∧ get($, i) = get(xs, j)>
    = when(xs) {
        Nil -> Nil()
        is Cons(h, t) -> insertSort(h, sortBy(t, f), f)
    }

@axiom fun insertSort[T](x: T, xs: List[T], f: (T, T) => Bool): List[T]
    <size($) = size(xs) + 1,
     ∀i. i + 1 < size($) → f(get($, i), get($, i + 1))>
    = when(xs) {
        Nil -> Cons(x, Nil())
        is Cons(h, t) -> if (f(x, h)) { Cons(x, Cons(h, t)) }
                         else { Cons(h, insertSort(x, t, f)) }
    }

@axiom fun range(a: Nat, b: Nat): List[Nat]
    <a ≤ b → size($) = b - a ∧ ∀i. i < size($) → get($, i) = a + i,
     a > b → size($) = 0>
{
    if (a < b) {
        unchecked var rest = range(a + 1, b)
        return Cons(a, rest)
    }
    return Nil()
}

@axiom fun zip[A, B](xs: List[A], ys: List[B]): List[(A, B)]
    <size($) = min(size(xs), size(ys)),
     ∀i. i < size($) → get($, i) = (get(xs, i), get(ys, i))>
    = when(xs) {
        Nil -> Nil()
        is Cons(h, t) -> when(ys) {
            Nil -> Nil()
            is Cons(h2, t2) -> Cons((h, h2), zip(t, t2))
        }
    }

@axiom fun joinToString[T](xs: List[T], sep: Str): Str
    <size(xs) = 0 → $ = "",
     size(xs) > 0 → $ = toStr(get(xs, 0)) + concat(sep, joinToString(drop(xs, 1), sep))>
    = fold(xs, "", { acc, x => if (acc == "") { toStr(x) } else { concat(acc, concat(sep, toStr(x))) } })

fun sum(xs: List[Nat]): Nat
    <$ = fold(xs, 0, { acc, x => acc + x })>
    = fold(xs, 0, { acc, x => acc + x })

@axiom fun maxNat(xs: List[Nat]): Optional[Nat]
    <size(xs) = 0 → $ = None(),
     size(xs) > 0 → isSome($) ∧ ∀i. i < size(xs) → getOrElse($, 0) ≥ get(xs, i)>
    = when(xs) {
        Nil -> None()
        is Cons(h, t) -> when(t) {
            Nil -> Some(h)
            is Cons(_, _) -> when(maxNat(t)) {
                is Some(v) -> if (h > v) { Some(h) } else { Some(v) }
                None -> Some(h)
            }
        }
    }

@axiom fun minNat(xs: List[Nat]): Optional[Nat]
    <size(xs) = 0 → $ = None(),
     size(xs) > 0 → isSome($) ∧ ∀i. i < size(xs) → getOrElse($, 0) ≤ get(xs, i)>
    = when(xs) {
        Nil -> None()
        is Cons(h, t) -> when(t) {
            Nil -> Some(h)
            is Cons(_, _) -> when(minNat(t)) {
                is Some(v) -> if (h < v) { Some(h) } else { Some(v) }
                None -> Some(h)
            }
        }
    }


enum Optional[T] {
    Some(T)
    None()
}

impl Functor[Optional] {
    @axiom fun map[A, B](fa: Optional[A], f: (A) => B): Optional[B]
        <isNone(fa) → isNone($),
         isSome(fa) → isSome($) ∧ getOrElse($, default) = f(getOrElse(fa, default))>
        = when(fa) {
            is Some(v) -> Some(f(v))
            None -> None()
        }
}

impl Foldable[Optional] {
    @axiom fun fold[A, R](fa: Optional[A], init: R, f: (R, A) => R): R
        <isNone(fa) → $ = init,
         isSome(fa) → $ = f(init, getOrElse(fa, default))>
        = when(fa) {
            is Some(v) -> f(init, v)
            None -> init
        }
}

impl Monad[Optional] {
    @axiom fun pure[A](x: A): Optional[A]
        <isSome($) ∧ getOrElse($, x) = x>
        = Some(x)

    @axiom fun flatMap[A, B](fa: Optional[A], f: (A) => Optional[B]): Optional[B]
        <isNone(fa) → isNone($),
         isSome(fa) → $ = f(getOrElse(fa, default))>
        = when(fa) {
            is Some(v) -> f(v)
            None -> None()
        }
}

@axiom fun isSome[T](o: Optional[T]): Bool
    <$ ↔ size(o) = 1>
    = when(o) {
        is Some(_) -> true
        None -> false
    }

@axiom fun isNone[T](o: Optional[T]): Bool
    <$ ↔ size(o) = 0>
    = when(o) {
        is Some(_) -> false
        None -> true
    }

@axiom fun getOrElse[T](o: Optional[T], d: T): T
    <(∀v. o = Some(v)) → $ = v,
     o = None() → $ = d>
    = when(o) {
        is Some(v) -> v
        None -> d
    }

@axiom fun orElse[T](o: Optional[T], d: Optional[T]): Optional[T]
    <isSome(o) → $ = o,
     isNone(o) → $ = d>
    = when(o) {
        is Some(_) -> o
        None -> d
    }

@axiom fun filter[T](o: Optional[T], p: (T) => Bool): Optional[T]
    <isNone(o) → isNone($),
     isSome(o) ∧ p(getOrElse(o, default)) → $ = o,
     isSome(o) ∧ ¬p(getOrElse(o, default)) → isNone($)>
    = when(o) {
        is Some(v) -> if (p(v)) { Some(v) } else { None() }
        None -> None()
    }

@axiom fun toResult[T, E](o: Optional[T], e: E): Result[T, E]
    <isSome(o) → ∃v. $ = Ok(v) ∧ v = getOrElse(o, v),
     isNone(o) → $ = Err(e)>
    = when(o) {
        is Some(v) -> Ok(v)
        None -> Err(e)
    }

@axiom fun toList[T](o: Optional[T]): List[T]
    <isNone(o) → size($) = 0,
     isSome(o) → size($) = 1 ∧ get($, 0) = getOrElse(o, default)>
    = when(o) {
        is Some(v) -> Cons(v, Nil())
        None -> Nil()
    }


enum Result[T, E] {
    Ok(T)
    Err(E)
}

impl Functor[Result[_, E]] {
    @axiom fun map[A, B](fa: Result[A, E], f: (A) => B): Result[B, E]
        <(∀e. fa = Err(e)) → $ = Err(e),
         (∀v. fa = Ok(v)) → $ = Ok(f(v))>
        = when(fa) {
            is Ok(v) -> Ok(f(v))
            is Err(e) -> Err(e)
        }
}

impl Foldable[Result[_, E]] {
    @axiom fun fold[A, R](fa: Result[A, E], init: R, f: (R, A) => R): R
        <(∀e. fa = Err(e)) → $ = init,
         (∀v. fa = Ok(v)) → $ = f(init, v)>
        = when(fa) {
            is Ok(v) -> f(init, v)
            is Err(_) -> init
        }
}

impl Monad[Result[_, E]] {
    @axiom fun pure[A](x: A): Result[A, E]
        <$ = Ok(x)>
        = Ok(x)

    @axiom fun flatMap[A, B](fa: Result[A, E], f: (A) => Result[B, E]): Result[B, E]
        <(∀e. fa = Err(e)) → $ = Err(e),
         (∀v. fa = Ok(v)) → $ = f(v)>
        = when(fa) {
            is Ok(v) -> f(v)
            is Err(e) -> Err(e)
        }
}

@axiom fun isOk[T, E](r: Result[T, E]): Bool
    <$ ↔ ∃v. r = Ok(v)>
    = when(r) {
        is Ok(_) -> true
        is Err(_) -> false
    }

@axiom fun isErr[T, E](r: Result[T, E]): Bool
    <$ ↔ ∃e. r = Err(e)>
    = when(r) {
        is Ok(_) -> false
        is Err(_) -> true
    }

@axiom fun unwrapOr[T, E](r: Result[T, E], d: T): T
    <(∀v. r = Ok(v)) → $ = v,
     (∀e. r = Err(e)) → $ = d>
    = when(r) {
        is Ok(v) -> v
        is Err(_) -> d
    }

@axiom fun mapErr[T, E, F](r: Result[T, E], f: (E) => F): Result[T, F]
    <(∀v. r = Ok(v)) → $ = Ok(v),
     (∀e. r = Err(e)) → $ = Err(f(e))>
    = when(r) {
        is Ok(v) -> Ok(v)
        is Err(e) -> Err(f(e))
    }

@axiom fun filter[T, E](r: Result[T, E], p: (T) => Bool): Result[T, E]
    <$ = r>
    = r

@axiom fun toList[T, E](r: Result[T, E]): List[T]
    <(∀e. r = Err(e)) → size($) = 0,
     (∀v. r = Ok(v)) → size($) = 1 ∧ get($, 0) = v>
    = when(r) {
        is Ok(v) -> Cons(v, Nil())
        is Err(_) -> Nil()
    }


enum Set[T] {
    SetNil()
    SetCons(T, Set[T])
}

impl Functor[Set] {
    @axiom fun map[A, B](fa: Set[A], f: (A) => B): Set[B]
        <∀a. a ∈ fa → f(a) ∈ $,
         ∀b. b ∈ $ → ∃a. a ∈ fa ∧ f(a) = b>
        = when(fa) {
            SetNil -> SetNil()
            is SetCons(h, t) -> add(map(t, f), f(h))
        }
}

impl Foldable[Set] {
    @axiom fun fold[A, R](fa: Set[A], init: R, f: (R, A) => R): R
        <(fa = SetNil()) → $ = init,
         (∀h t. fa = SetCons(h, t)) → $ = fold(t, f(init, h), f)>
        = when(fa) {
            SetNil -> init
            is SetCons(h, t) -> fold(t, f(init, h), f)
        }
}

@axiom fun setEmpty[T](): Set[T]
    <size($) = 0>
    = SetNil()

@axiom fun setOf[T](@list items: T): Set[T]
    <∀x. x ∈ $ ↔ x ∈ items>
    = SetNil()

@axiom fun add[T](s: Set[T], x: T): Set[T]
    <x ∈ $,
     ∀y. y ∈ $ ↔ (y ∈ s ∨ y = x),
     size($) = (if x ∈ s then size(s) else size(s) + 1)>
    = if (contains(s, x)) { s } else { SetCons(x, s) }

@axiom fun remove[T](s: Set[T], x: T): Set[T]
    <x ∉ $,
     ∀y. y ∈ $ ↔ (y ∈ s ∧ y ≠ x),
     size($) = (if x ∈ s then size(s) - 1 else size(s))>
    = when(s) {
        SetNil -> SetNil()
        is SetCons(h, t) -> if (h == x) { t } else { SetCons(h, remove(t, x)) }
    }

@axiom fun union[T](s1: Set[T], s2: Set[T]): Set[T]
    <∀x. x ∈ $ ↔ (x ∈ s1 ∨ x ∈ s2),
     size($) ≤ size(s1) + size(s2)>
    = when(s1) {
        SetNil -> s2
        is SetCons(h, t) -> if (contains(s2, h)) { union(t, s2) } else { SetCons(h, union(t, s2)) }
    }

@axiom fun intersect[T](s1: Set[T], s2: Set[T]): Set[T]
    <∀x. x ∈ $ ↔ (x ∈ s1 ∧ x ∈ s2),
     size($) ≤ min(size(s1), size(s2))>
    = when(s1) {
        SetNil -> SetNil()
        is SetCons(h, t) -> if (contains(s2, h)) { SetCons(h, intersect(t, s2)) } else { intersect(t, s2) }
    }

@axiom fun filter[T](s: Set[T], p: (T) => Bool): Set[T]
    <∀x. x ∈ $ ↔ (x ∈ s ∧ p(x)),
     size($) ≤ size(s)>
    = when(s) {
        SetNil -> SetNil()
        is SetCons(h, t) -> if (p(h)) { SetCons(h, filter(t, p)) } else { filter(t, p) }
    }

@axiom fun flatMap[T, U](s: Set[T], f: (T) => Set[U]): Set[U]
    <∀y. y ∈ $ ↔ ∃x. x ∈ s ∧ y ∈ f(x)>
    = when(s) {
        SetNil -> SetNil()
        is SetCons(h, t) -> union(f(h), flatMap(t, f))
    }

@axiom fun toList[T](s: Set[T]): List[T]
    <size($) = size(s),
     ∀x. x ∈ s ↔ ∃i. i < size($) ∧ get($, i) = x>
    = when(s) {
        SetNil -> Nil()
        is SetCons(h, t) -> Cons(h, toList(t))
    }


enum Map[K, V] {
    MapNil()
    MapCons(K, V, Map[K, V])
}

impl Functor[Map[K, _]] {
    @axiom fun map[A, B](fa: Map[K, A], f: (A) => B): Map[K, B]
        <∀k. get($, k) = when(get(fa, k)) {
            is Some(v) -> Some(f(v))
            None -> None()
        }>
        = when(fa) {
            MapNil -> MapNil()
            is MapCons(k, v, t) -> MapCons(k, f(v), map(t, f))
        }
}

impl Foldable[Map[K, _]] {
    @axiom fun fold[A, R](fa: Map[K, A], init: R, f: (R, A) => R): R
        <$ = fold(values(fa), init, f)>
        = when(fa) {
            MapNil -> init
            is MapCons(_, v, t) -> fold(t, f(init, v), f)
        }
}

@axiom fun mapEmpty[K, V](): Map[K, V]
    <size($) = 0>
    = MapNil()

@axiom fun get[K, V](m: Map[K, V], k: K): Optional[V]
    <(∃v. m = MapCons(k, v, _)) → $ = Some(v),
     (∀k0 v0 t. m = MapCons(k0, v0, t) ∧ k0 ≠ k) → $ = get(t, k),
     m = MapNil() → $ = None()>
    = when(m) {
        MapNil -> None()
        is MapCons(k0, v0, t) -> if (k0 == k) { Some(v0) } else { get(t, k) }
    }

@axiom fun containsKey[K, V](m: Map[K, V], k: K): Bool
    <$ ↔ isSome(get(m, k))>
    = when(m) {
        MapNil -> false
        is MapCons(k0, _, t) -> if (k0 == k) { true } else { containsKey(t, k) }
    }

@axiom fun keys[K, V](m: Map[K, V]): List[K]
    <size($) = size(m),
     ∀k. (∃i. i < size($) ∧ get($, i) = k) ↔ isSome(get(m, k))>
    = when(m) {
        MapNil -> Nil()
        is MapCons(k0, _, t) -> Cons(k0, keys(t))
    }

@axiom fun values[K, V](m: Map[K, V]): List[V]
    <size($) = size(m)>
    = when(m) {
        MapNil -> Nil()
        is MapCons(_, v0, t) -> Cons(v0, values(t))
    }

@axiom fun put[K, V](m: Map[K, V], k: K, v: V): Map[K, V]
    <get($, k) = Some(v),
     ∀k0. k0 ≠ k → get($, k0) = get(m, k0),
     size($) = (if containsKey(m, k) then size(m) else size(m) + 1)>
    = MapCons(k, v, remove(m, k))

@axiom fun remove[K, V](m: Map[K, V], k: K): Map[K, V]
    <get($, k) = None(),
     ∀k0. k0 ≠ k → get($, k0) = get(m, k0),
     size($) = (if containsKey(m, k) then size(m) - 1 else size(m))>
    = when(m) {
        MapNil -> MapNil()
        is MapCons(k0, v0, t) -> if (k0 == k) { t } else { MapCons(k0, v0, remove(t, k)) }
    }

@axiom fun mapValues[K, V, W](m: Map[K, V], f: (V) => W): Map[K, W]
    <size($) = size(m),
     ∀k. get($, k) = when(get(m, k)) {
         is Some(v) -> Some(f(v))
         None -> None()
     }>
    = when(m) {
        MapNil -> MapNil()
        is MapCons(k0, v0, t) -> MapCons(k0, f(v0), mapValues(t, f))
    }

@axiom fun mapKeys[K, V, W](m: Map[K, V], f: (K) => W): Map[W, V]
    <size($) ≤ size(m),
     ∀k. get($, f(k)) = get(m, k)>
    = when(m) {
        MapNil -> MapNil()
        is MapCons(k0, v0, t) -> put(mapKeys(t, f), f(k0), v0)
    }

@axiom fun filter[K, V](m: Map[K, V], p: (V) => Bool): Map[K, V]
    <∀k. get($, k) = when(get(m, k)) {
        is Some(v) -> if (p(v)) { Some(v) } else { None() }
        None -> None()
    }>
    = when(m) {
        MapNil -> MapNil()
        is MapCons(k0, v0, t) -> if (p(v0)) { MapCons(k0, v0, filter(t, p)) }
                                 else { filter(t, p) }
    }

@axiom fun merge[K, V](m1: Map[K, V], m2: Map[K, V]): Map[K, V]
    <∀k. get($, k) = when(get(m2, k)) {
        is Some(v) -> Some(v),
        None -> get(m1, k)
    }>
    = when(m2) {
        MapNil -> m1
        is MapCons(k0, v0, t) -> merge(put(m1, k0, v0), t)
    }

@axiom fun toList[K, V](m: Map[K, V]): List[V]
    <size($) = size(m)>
    = values(m)


class Tuple {
    fun size(): Nat
    @axiom fun isEmpty(): Bool
}

impl Tuple for EmptyTuple {
    fun size(): Nat = 0
    @axiom fun isEmpty(): Bool <$ = true> = true
}

impl Tuple for SingleTuple[a] {
    fun size(): Nat = 1
    @axiom fun isEmpty(): Bool <$ = false> = false
}

impl Tuple for (a, b) {
    fun size(): Nat = 2
    @axiom fun isEmpty(): Bool <$ = false> = false
}

impl Tuple for (a, b, c) {
    fun size(): Nat = 3
    @axiom fun isEmpty(): Bool <$ = false> = false
}

impl Tuple for (a, b, c, d) {
    fun size(): Nat = 4
    @axiom fun isEmpty(): Bool <$ = false> = false
}

impl Tuple for (a, b, c, d, e) {
    fun size(): Nat = 5
    @axiom fun isEmpty(): Bool <$ = false> = false
}

impl Tuple for (a, b, c, d, e, f) {
    fun size(): Nat = 6
    @axiom fun isEmpty(): Bool <$ = false> = false
}

impl Tuple for (a, b, c, d, e, f, g) {
    fun size(): Nat = 7
    @axiom fun isEmpty(): Bool <$ = false> = false
}

impl Tuple for (a, b, c, d, e, f, g, h) {
    fun size(): Nat = 8
    @axiom fun isEmpty(): Bool <$ = false> = false
}

impl Tuple for (a, b, c, d, e, f, g, h, i) {
    fun size(): Nat = 9
    @axiom fun isEmpty(): Bool <$ = false> = false
}

impl Tuple for (a, b, c, d, e, f, g, h, i, j) {
    fun size(): Nat = 10
    @axiom fun isEmpty(): Bool <$ = false> = false
}

@axiom fun toSet[A](xs: List[A]): Set[A]
    <∀x. x ∈ $ ↔ x ∈ xs>
    = when(xs) {
        Nil -> SetNil()
        is Cons(h, t) -> add(toSet(t), h)
    }

@axiom fun toMap[K, V](xs: List[(K, V)]): Map[K, V]
    <∀k. get($, k) = when(indexOf(map(xs, { p => fst(p) }), k)) {
        is Some(i) -> Some(snd(get(xs, i)))
        None -> None()
    }>
    = when(xs) {
        Nil -> MapNil()
        is Cons(pr, t) -> when(pr) {
            (k, v) -> put(toMap(t), k, v)
        }
    }
