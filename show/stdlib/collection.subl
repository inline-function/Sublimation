// Sublimation 标准库（v2.0 Kotlin 化）：Set（集合）与 Map（表）
// 独立枚举实现（结构递归自动停机）；方法糖 `s.contains(x)` / `m.get(k)` → 接收者前置的自由函数调用。
// v2.0：与 List/Optional 的同名方法（size/contains/map…）通过**重载**共存，按接收者类型分派。
enum Set[T] { SetNil(), SetCons(T, Set[T]) }
enum Map[K, V] { MapNil(), MapCons(K, V, Map[K, V]) }

fun setEmpty[T](): Set[T] = SetNil()
fun mapEmpty[K, V](): Map[K, V] = MapNil()

fun size[T](xs: Set[T]): Nat = when(xs) {
    SetNil -> 0
    is SetCons(_, t) -> 1 + size(t)
}

fun isEmpty[T](xs: Set[T]): Bool = when(xs) {
    SetNil -> true
    is SetCons(_, _) -> false
}

fun contains[T](xs: Set[T], x: T): Bool = when(xs) {
    SetNil -> false
    is SetCons(h, t) -> if (h == x) { true } else { contains(t, x) }
}

fun add[T](xs: Set[T], x: T): Set[T] = if (contains(xs, x)) { xs } else { SetCons(x, xs) }

fun remove[T](xs: Set[T], x: T): Set[T] = when(xs) {
    SetNil -> SetNil()
    is SetCons(h, t) -> if (h == x) { remove(t, x) } else { SetCons(h, remove(t, x)) }
}

fun union[T](xs: Set[T], ys: Set[T]): Set[T] = when(xs) {
    SetNil -> ys
    is SetCons(h, t) -> if (contains(ys, h)) { union(t, ys) } else { SetCons(h, union(t, ys)) }
}

fun intersect[T](xs: Set[T], ys: Set[T]): Set[T] = when(xs) {
    SetNil -> SetNil()
    is SetCons(h, t) -> if (contains(ys, h)) { SetCons(h, intersect(t, ys)) } else { intersect(t, ys) }
}

fun toList[T](xs: Set[T]): List[T] = when(xs) {
    SetNil -> Nil()
    is SetCons(h, t) -> Cons(h, toList(t))
}

fun get[K, V](m: Map[K, V], k: K): Optional[V] = when(m) {
    MapNil -> None()
    is MapCons(k0, v0, t) -> if (k0 == k) { Some(v0) } else { get(t, k) }
}

fun put[K, V](m: Map[K, V], k: K, v: V): Map[K, V] = MapCons(k, v, m)

fun size[K, V](m: Map[K, V]): Nat = when(m) {
    MapNil -> 0
    is MapCons(_, _, t) -> 1 + size(t)
}

fun containsKey[K, V](m: Map[K, V], k: K): Bool = when(m) {
    MapNil -> false
    is MapCons(k0, _, t) -> if (k0 == k) { true } else { containsKey(t, k) }
}

fun remove[K, V](m: Map[K, V], k: K): Map[K, V] = when(m) {
    MapNil -> MapNil()
    is MapCons(k0, v0, t) -> if (k0 == k) { t } else { MapCons(k0, v0, remove(t, k)) }
}

fun keys[K, V](m: Map[K, V]): List[K] = when(m) {
    MapNil -> Nil()
    is MapCons(k0, _, t) -> Cons(k0, keys(t))
}

fun values[K, V](m: Map[K, V]): List[V] = when(m) {
    MapNil -> Nil()
    is MapCons(_, v0, t) -> Cons(v0, values(t))
}

// List → Set 转换（v2.0 基本库）
fun toSet[A](xs: List[A]): Set[A] = when(xs) {
    Nil -> SetNil()
    is Cons(h, t) -> add(toSet(t), h)
}

// List[(K,V)] → Map 转换（v2.0 基本库）。元组解构用 when (k, v) ->（无元组下标语法）。
fun toMap[K, V](xs: List[(K, V)]): Map[K, V] = when(xs) {
    Nil -> MapNil()
    is Cons(pr, t) -> when(pr) {
        (k, v) -> put(toMap(t), k, v)
    }
}

// ---- v3.0：可变元组（@vararg @tuple，Kotlin vararg 语义）与 Set 的函数式方法 ----
// setOf：任意数量同型实参打包成 Set。codegen 特判生成 SetCons 链（变长元组无法结构拆解，body 仅为类型声明）。
fun setOf[T](@vararg @tuple _items: (T)): Set[T] = SetNil()

// Set.map：Kotlin 语义（Set → List）
fun map[T, U](xs: Set[T], f: (T) => U): List[U] = when(xs) {
    SetNil -> Nil()
    is SetCons(h, t) -> Cons(f(h), map(t, f))
}

// Set.forEach：无返回值（块体 → Null）
fun forEach[T](xs: Set[T], f: (T) => Null) {
    when(xs) {
        SetNil -> null
        is SetCons(h, t) -> { f(h); forEach(t, f) }
    }
    return null
}
// Sublimation 标准库（v2.0 Kotlin 化）：List —— 接收者风格 `xs.map {}` / `xs.filter {}` / `xs.forEach {}`
// 挂载方式：编译入口根目录下的 stdlib/ 子模块，编译器为每个用户模块**隐式挂载**（无需写 settings）。
// 类型实参统一方括号：声明 `enum List[T]`、实例化 `List[U]`。
// v2.0：同名方法（size/map/filter/contains…）在不同容器类型上**重载**——方法糖按接收者类型分派。
enum List[T] { Nil(), Cons(T, List[T]) }

fun listLength[T](xs: List[T]): Nat = when(xs) {
    Nil -> 0
    is Cons(_, t) -> 1 + listLength(t)
}

// Kotlin 风格：xs.size()（List/Set/Map 各有同名重载，路由按接收者）
fun size[T](xs: List[T]): Nat = when(xs) {
    Nil -> 0
    is Cons(_, t) -> 1 + size(t)
}

fun isEmpty[T](xs: List[T]): Bool = when(xs) {
    Nil -> true
    is Cons(_, _) -> false
}

fun head[T](xs: List[T]): Optional[T] = when(xs) {
    Nil -> None()
    is Cons(h, _) -> Some(h)
}

fun last[T](xs: List[T]): Optional[T] = when(xs) {
    Nil -> None()
    is Cons(h, Nil) -> Some(h)
    is Cons(_, t) -> last(t)
}

fun contains[T](xs: List[T], x: T): Bool = when(xs) {
    Nil -> false
    is Cons(h, t) -> if (h == x) { true } else { contains(t, x) }
}

fun elementAt[T](xs: List[T], i: Nat): Optional[T] = when(xs) {
    Nil -> None()
    is Cons(h, t) -> if (i == 0) { Some(h) } else { elementAt(t, i - 1) }
}

fun count[T](xs: List[T], f: (T) => Bool): Nat = when(xs) {
    Nil -> 0
    is Cons(h, t) -> if (f(h)) { 1 + count(t, f) } else { count(t, f) }
}

fun map[T, U](xs: List[T], f: (T) => U): List[U] = when(xs) {
    Nil -> Nil()
    is Cons(h, t) -> Cons(f(h), map(t, f))
}

fun flatMap[T, U](xs: List[T], f: (T) => List[U]): List[U] = when(xs) {
    Nil -> Nil()
    is Cons(h, t) -> append(f(h), flatMap(t, f))
}

fun filter[T](xs: List[T], f: (T) => Bool): List[T] = when(xs) {
    Nil -> Nil()
    is Cons(h, t) -> if (f(h)) { Cons(h, filter(t, f)) } else { filter(t, f) }
}

fun fold[T, U](xs: List[T], init: U, f: (T, U) => U): U = when(xs) {
    Nil -> init
    is Cons(h, t) -> fold(t, f(h, init), f)
}

// forEach：无返回值（块体 → Null）。when 分支体是值位，故用尾 `return null` 收束（分支内 return 暂不展平）。
fun forEach[T](xs: List[T], f: (T) => Null) {
    when(xs) {
        Nil -> null
        is Cons(h, t) -> { f(h); forEach(t, f) }
    }
    return null
}

fun append[T](xs: List[T], ys: List[T]): List[T] = when(xs) {
    Nil -> ys
    is Cons(h, t) -> Cons(h, append(t, ys))
}

fun reverse[T](xs: List[T]): List[T] = when(xs) {
    Nil -> Nil()
    is Cons(h, t) -> append(reverse(t), Cons(h, Nil()))
}

// 数值递减递归（a → a+1），非结构子项——按 P9 用 unchecked 逃逸标注。
fun range(a: Nat, b: Nat): List[Nat] {
    if (a < b) {
        unchecked var rest = range(a + 1, b)
        return Cons(a, rest)
    }
    return Nil()
}

fun take[T](xs: List[T], n: Nat): List[T] = when(xs) {
    Nil -> Nil()
    is Cons(h, t) -> if (n == 0) { Nil() } else { unchecked var r = take(t, n - 1); Cons(h, r) }
}

fun drop[T](xs: List[T], n: Nat): List[T] = when(xs) {
    Nil -> Nil()
    is Cons(h, t) -> if (n == 0) { xs } else { unchecked var r = drop(t, n - 1); r }
}

// zip 恢复（v2.0 记录：#基础库）：类型参数命名 **A/B** 而非 T/U——Cons 构造子的枚举类型参数也叫 T，
// 提取绑定 `T := (T,U)` 触发 occurs check 自指误判（TypeInfer 只按名字统计类型变量）。
// 编译器哲学"用户避开重名"——改名即修复，无需 alpha 化。
fun zip[A, B](xs: List[A], ys: List[B]): List[(A, B)] = when(xs) {
    Nil -> Nil()
    is Cons(h, t) -> when(ys) {
        Nil -> Nil()
        is Cons(h2, t2) -> Cons((h, h2), zip(t, t2))
    }
}

fun joinToString[T](xs: List[T], sep: Str): Str =
    fold(xs, "", { x, acc -> if (acc == "") { toStr(x) } else { concat(acc, concat(sep, toStr(x))) } })

fun sum(xs: List[Nat]): Nat = fold(xs, 0, { x, acc -> acc + x })

fun maxNat(xs: List[Nat]): Optional[Nat] = when(xs) {
    Nil -> None()
    is Cons(h, t) -> when(t) {
        Nil -> Some(h)
        is Cons(_, _) -> { var m = maxNat(t); when(m) { is Some(v) -> if (h > v) { Some(h) } else { Some(v) }; None -> Some(h) } }
    }
}

fun minNat(xs: List[Nat]): Optional[Nat] = when(xs) {
    Nil -> None()
    is Cons(h, t) -> when(t) {
        Nil -> Some(h)
        is Cons(_, _) -> { var m = minNat(t); when(m) { is Some(v) -> if (h < v) { Some(h) } else { Some(v) }; None -> Some(h) } }
    }
}

// 去重（v2.0 基本库）：保留首次出现顺序。类型参数 A 避开 Cons 的 T 撞名（同 zip 注释）。
fun distinct[A](xs: List[A]): List[A] = when(xs) {
    Nil -> Nil()
    is Cons(h, t) -> if (contains(t, h)) { distinct(t) } else { Cons(h, distinct(t)) }
}

// ---- v2.0 基本库补全（2026-10-10）：any / all / indexOf / slice / sortBy ----
// 声明自举（结构递归，停机判定通过）；codegen 特判成 JS 原生数组方法（any→.some、all→.every…）。

fun any[T](xs: List[T], f: (T) => Bool): Bool = when(xs) {
    Nil -> false
    is Cons(h, t) -> if (f(h)) { true } else { any(t, f) }
}

fun all[T](xs: List[T], f: (T) => Bool): Bool = when(xs) {
    Nil -> true
    is Cons(h, t) -> if (f(h)) { all(t, f) } else { false }
}

fun indexOf[T](xs: List[T], x: T): Optional[Nat] = when(xs) {
    Nil -> None()
    is Cons(h, t) -> if (h == x) { Some(0) } else { when(indexOf(t, x)) { is Some(n) -> Some(n + 1); None -> None() } }
}

fun slice[T](xs: List[T], a: Nat, b: Nat): List[T] = when(xs) {
    Nil -> Nil()
    is Cons(h, t) -> if (a > 0) { unchecked var r = slice(t, a - 1, b - 1); r }
        else if (b == 0) { Nil() }
        else { unchecked var r2 = slice(t, 0, b - 1); Cons(h, r2) }
}

// 稳定排序：f(a, b) 为 true ⇒ a 排在 b 前。稳定排序用插入排序自举。
fun sortBy[T](xs: List[T], f: (T, T) => Bool): List[T] = when(xs) {
    Nil -> Nil()
    is Cons(h, t) -> insertSort(h, sortBy(t, f), f)
}

fun insertSort[T](x: T, xs: List[T], f: (T, T) => Bool): List[T] = when(xs) {
    Nil -> Cons(x, Nil())
    is Cons(h, t) -> if (f(x, h)) { Cons(x, Cons(h, t)) } else { Cons(h, insertSort(x, t, f)) }
}
// Sublimation 标准库（v2.0 Kotlin 化）：Result / Optional
// Result[T, E]：Ok(T) 成功携带值；Err(E) 失败携带错误信息（比 Optional 多错误通道）
// Optional[T]（Some/None）是编译器内建枚举，表达「有/无」。
// v2.0：map/flatMap/filter 与 List / Set 同名**重载**——方法糖按接收者类型分派。
enum Result[T, E] { Ok(T), Err(E) }

fun isOk[T, E](r: Result[T, E]): Bool = when(r) {
    is Ok(_) -> true
    is Err(_) -> false
}

fun isErr[T, E](r: Result[T, E]): Bool = when(r) {
    is Ok(_) -> false
    is Err(_) -> true
}

fun unwrapOr[T, E](r: Result[T, E], d: T): T = when(r) {
    is Ok(x) -> x
    is Err(_) -> d
}

fun map[T, U, E](r: Result[T, E], f: (T) => U): Result[U, E] = when(r) {
    is Ok(x) -> Ok(f(x))
    is Err(e) -> Err(e)
}

fun flatMap[T, U, E](r: Result[T, E], f: (T) => Result[U, E]): Result[U, E] = when(r) {
    is Ok(x) -> f(x)
    is Err(e) -> Err(e)
}

fun mapErr[T, E, F](r: Result[T, E], f: (E) => F): Result[T, F] = when(r) {
    is Ok(x) -> Ok(x)
    is Err(e) -> Err(f(e))
}

// mapResult / flatMapResult 保留（v1.1 名字，P5 验收用）
fun mapResult[T, U, E](r: Result[T, E], f: (T) => U): Result[U, E] = when(r) {
    is Ok(x) -> Ok(f(x))
    is Err(e) -> Err(e)
}

// ---------- Optional 便捷方法（接收者风格 o.map {} / o.getOrElse {}） ----------

fun map[T, U](o: Optional[T], f: (T) => U): Optional[U] = when(o) {
    is Some(x) -> Some(f(x))
    None -> None()
}

fun flatMap[T, U](o: Optional[T], f: (T) => Optional[U]): Optional[U] = when(o) {
    is Some(x) -> f(x)
    None -> None()
}

fun filter[T](o: Optional[T], f: (T) => Bool): Optional[T] = when(o) {
    is Some(x) -> if (f(x)) { o } else { None() }
    None -> None()
}

fun isSome[T](o: Optional[T]): Bool = when(o) {
    is Some(_) -> true
    None -> false
}

fun isNone[T](o: Optional[T]): Bool = when(o) {
    is Some(_) -> false
    None -> true
}

fun getOrElse[T](o: Optional[T], d: T): T = when(o) {
    is Some(x) -> x
    None -> d
}

fun orElse[T](o: Optional[T], d: Optional[T]): Optional[T] = when(o) {
    is Some(_) -> o
    None -> d
}

fun toResult[T, E](o: Optional[T], e: E): Result[T, E] = when(o) {
    is Some(x) -> Ok(x)
    None -> Err(e)
}

// 构造便利：emptyList / listOf（@tulpe 可变元组 → 实参打包为 Cons 链，codegen 特判）
fun emptyList[T](): List[T] = Nil()
fun listOf[T](@tulpe t: T): List[T] = Cons(t, Nil())

// ---------- v3.0 第三批 4.2：Collection 型类体系 ----------
// 统一各容器的高阶查询：contains / size。方法式成员；扩展调用法（x.f()）优先类型类，自由函数用普通调用法 f(x)。
// Map 的 contains 按 key 判定（`k in map`）；Optional/Result 的 size 为 0/1。
class Collection {
    fun contains[T](element: T): Bool
    fun size(): Nat
    // isEmpty ⇔ size() = 0
    fun isEmpty(): Bool
}
impl Collection for List[a] {
    fun contains[T](element: T): Bool = when (self) {
        Nil -> false
        is Cons(h, t) -> if (h == element) { true } else { t.contains(element) }
    }
    fun size(): Nat = when (self) {
        Nil -> 0
        is Cons(_, t) -> 1 + t.size()
    }
    fun isEmpty(): Bool = self.size() == 0
}
impl Collection for Set[a] {
    fun contains[T](element: T): Bool = when (self) {
        SetNil -> false
        is SetCons(h, t) -> if (h == element) { true } else { t.contains(element) }
    }
    fun size(): Nat = when (self) {
        SetNil -> 0
        is SetCons(_, t) -> 1 + t.size()
    }
    fun isEmpty(): Bool = self.size() == 0
}
impl Collection for Map[k, v] {
    fun contains[T](element: T): Bool = when (self) {
        MapNil -> false
        is MapCons(k0, v0, t) -> if (k0 == element) { true } else { t.contains(element) }
    }
    fun size(): Nat = when (self) {
        MapNil -> 0
        is MapCons(_, _, t) -> 1 + t.size()
    }
    fun isEmpty(): Bool = self.size() == 0
}
impl Collection for Optional[a] {
    fun contains[T](element: T): Bool = when (self) {
        is Some(x) -> x == element
        None -> false
    }
    fun size(): Nat = when (self) {
        is Some(_) -> 1
        None -> 0
    }
    fun isEmpty(): Bool = self.size() == 0
}
impl Collection for Result[a, e] {
    fun contains[T](element: T): Bool = when (self) {
        is Ok(x) -> x == element
        is Err(_) -> false
    }
    fun size(): Nat = when (self) {
        is Ok(_) -> 1
        is Err(_) -> 0
    }
    fun isEmpty(): Bool = self.size() == 0
}

// ---------- v3.0 第三批 4.3：Tuple 类型族（决策 61/62）----------
// EmptyTuple/SingleTuple[T]/(T,U)/(T,U,V) 统一抽象为 Tuple 型类：size/isEmpty（元组共有函数）。
class Tuple {
    fun size(): Nat
    fun isEmpty(): Bool
}
impl Tuple for EmptyTuple {
    fun size(): Nat = 0
    fun isEmpty(): Bool = true
}
impl Tuple for SingleTuple[a] {
    fun size(): Nat = 1
    fun isEmpty(): Bool = false
}
impl Tuple for (a, b) {
    fun size(): Nat = 2
    fun isEmpty(): Bool = false

}
impl Tuple for (a, b, c) {
    fun size(): Nat = 3
    fun isEmpty(): Bool = false
}

// ---------- Functor 型类（高阶类型）：map/lift 统一入口（方法糖优先自由函数，实施理见 CallCheck sugar-first）----------
// 注：HKT 点号式（receiver 在 kind 应用位）的字典调用实参装配仍需完善；容器 map 由同名自由函数承载。
class Functor[F[_]] {
    fun map[A, B](fa: F[A], f: (A) => B): F[B]
}
