// stdlib.order —— 序关系通用定理与 Ord 类型类（依赖：logic）
//
// Ord：统一的大小比较类型类（方法式成员，接收者即左操作数）。
// 依据（实现选择）：Nat/Int/Rat 经类型推导数值提升（typeLooseEq）彼此宽松相等，
// 对同一类型类分别 impl 会让数值接收者同时命中多个实例（E-AMBIGUOUS-INSTANCE）；
// 故数值只对 Rat 实现一份 impl——任何数值接收者（Nat/Int/Rat）都路由到它。
// 字符串按字典序（strCmp）独立实现。

class Ord[T] {
    // 依据：序关系的四向判定；lt/le 为核（gt/ge 派生）。
    fun lt(other: T): Bool
    fun le(other: T): Bool
    fun gt(other: T): Bool
    fun ge(other: T): Bool
}

// 依据：数值原生的 < <= > >=（JS Number 语义）。
impl Ord for Rat {
    fun lt(other: Rat): Bool = self < other
    fun le(other: Rat): Bool = self <= other
    fun gt(other: Rat): Bool = self > other
    fun ge(other: Rat): Bool = self >= other
}

// 依据：strCmp 字典序（<0 / =0 / >0）。
impl Ord for Str {
    fun lt(other: Str): Bool = strCmp(self, other) < 0
    fun le(other: Str): Bool = strCmp(self, other) <= 0
    fun gt(other: Str): Bool = strCmp(self, other) > 0
    fun ge(other: Str): Bool = strCmp(self, other) >= 0
}

// ---------- 序定理（项级元变量在直接位，∴ 可命中同形目标；数值目标另有线性算术通道） ----------

// 依据：≤ 自反律（偏序公理）。
@theorem
fun `le refl`[a]: Null <a <= a>
// 依据：≤ 传递律（偏序公理）。
@theorem
fun `le trans`[a, b, c]: Null <(a <= b) & (b <= c) -> (a <= c)>
// 依据：≤ 反对称（偏序公理）。
@theorem
fun `le antisym`[a, b]: Null <(a <= b) & (b <= a) -> (a = b)>
// 依据：严格 < 蕴含 ≤。
@theorem
fun `lt le`[a, b]: Null <(a < b) -> (a <= b)>
// 依据：≤ 且不等 ⇒ 严格 <。
@theorem
fun `le lt`[a, b]: Null <(a <= b) & (a ≠ b) -> (a < b)>
// 依据：全序（任意两元素可比）——经典性质；数值比较原生满足。
@theorem
fun `le total`[a, b]: Null <(a <= b) ∨ (b <= a)>
// 依据：> 是 < 的翻转（镜像定律）。
@theorem
fun `mirror lt gt`[a, b]: Null <(a < b) -> (b > a)>
@theorem
fun `mirror le ge`[a, b]: Null <(a <= b) -> (b >= a)>
