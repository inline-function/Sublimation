// 脚本4：Optional 容器（when 解构 / 方法链 / 方法路径作值）
struct UserProfile(
    name : Str,
    email : Optional[Str],
    phone : Optional[Str],
)

fun firstInitial(name: Optional[Str]): Optional[Str] =
    name.map { s -> substring(s, 0, 1) }

var u = UserProfile("Alice", Some("a@x.com"), None())
when(u.email) { is Some(e) => print("邮箱=" + e); None => print("邮箱=无") }
when(u.phone) { is Some(p) => print("电话=" + p); None => print("电话=无") }

var eu: Optional[Str] = Some("alice")
when(eu) { is Some(s) => print("邮箱长度=" + toStr(length(s))); None => print("邮箱长度=空") }

// when 解构取值：Some(42) 的内部值经 is Some(v) 绑定到 v
var x: Optional[Nat] = Some(42)
when(x) { is Some(v) => print("解构=" + toStr(v)); None => print("解构=空") }

// 方法路径作值：xs.map 不加括号
var xs2 = listOf(1, 2, 3)
var m = xs2.map
var ys = m({ x -> x + 10 })
print("方法路径作值=" + toStr(ys))

var n: Optional[Nat] = Some(5)
print("链路=" + toStr(n.map { v -> v * 2 }.filter { v -> v > 5 }.getOrElse(0)))
print("orElse=" + toStr(None().orElse(Some(9)).getOrElse(0)))

when(Some(7).toResult("无值")) {
    is Ok(v) => print("toResult=$v")
    is Err(e) => print("错误=$e")
}

print("isSome=" + toStr(isSome(Some(1))))
print("isNone=" + toStr(isNone(None())))
print("首字母=" + firstInitial(Some("world")).getOrElse("?"))
