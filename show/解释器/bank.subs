// 脚本1：银行账户（顶层语句直接运行，无需 main；与其他脚本互不共享）
// 【全局类型推导版】所有类型/可变性/效应标注均已省略——run.bat 启动时回答 yes
// 开启全局类型推导后，由编译器按「显式 > 构造点 > 使用点 > 默认」自动填入
struct Account(
    owner,
    balance,
    country = "中国",
)

class AccountOps {
    fun show()
    fun level()
}

impl AccountOps for Account {
    fun show() = "$owner($country) 余额=¥$balance"
    fun level() = when {
        balance >= 1000 => "VIP"
        balance >= 500 => "金卡"
        else => "普通"
    }
}

fun tryWithdraw(cur, amount) =
    if (cur >= amount) { Ok(cur - amount) } else { Err("余额不足 $cur < $amount") }

fun transfer(from, dest, amount) =
    tryWithdraw(from, amount).flatMapOk { remaining => Ok("转出后剩" + toStr(remaining) + "，转入后" + toStr(dest + amount)) }

var acc = Account(owner = "张三", balance = 1000)
print("开户=" + acc.show())
print("等级=" + acc.level())
acc.balance = acc.balance + 500
print("存款后=" + acc.show())
when(tryWithdraw(acc.balance, 300)) {
    is Ok(b) => print("取300后余额=$b")
    is Err(e) => print("取300失败：$e")
}
print("取9999=" + toStr(tryWithdraw(acc.balance, 9999).unwrapOr(0)))
print("取200=" + tryWithdraw(acc.balance, 200).mapOk { b => "余$b" }.unwrapOr("失败"))
print("转账(600→200,150)=" + transfer(600, 200, 150).unwrapOr("失败"))
print("转账(50→200,150)=" + transfer(50, 200, 150).unwrapOr("失败"))
